---
import type { SEOConfig } from '../config/seo'
import { defaultSEO, siteMeta } from '../config/seo'

interface Props extends Partial<SEOConfig> {}

const { title, description, image, imageAlt, canonical, noindex, nofollow, type, author } =
  Astro.props

const seo = {
  title: title || defaultSEO.title,
  description: description || defaultSEO.description,
  image: image || defaultSEO.image,
  imageAlt: imageAlt || defaultSEO.imageAlt,
  type: type || defaultSEO.type,
  author: author || defaultSEO.author,
}

const canonicalURL = canonical
  ? new URL(canonical, siteMeta.url).href
  : new URL(Astro.url.pathname, siteMeta.url).href

const fullImageUrl = seo.image?.startsWith('http')
  ? seo.image
  : new URL(seo.image || '', siteMeta.url).href

const robotsContent = [noindex ? 'noindex' : 'index', nofollow ? 'nofollow' : 'follow'].join(', ')
---

<!-- Primary Meta Tags -->
<title>{seo.title}</title>
<meta name="title" content={seo.title} />
<meta name="description" content={seo.description} />
<meta name="author" content={seo.author} />
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content={robotsContent} />

<!-- Geo Tags -->
<meta name="geo.region" content="FR-42" />
<meta name="geo.placename" content="Pélussin" />
<meta name="geo.position" content={`${siteMeta.location.coordinates.latitude};${siteMeta.location.coordinates.longitude}`} />
<meta name="ICBM" content={`${siteMeta.location.coordinates.latitude}, ${siteMeta.location.coordinates.longitude}`} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={seo.type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:alt" content={seo.imageAlt} />
<meta property="og:site_name" content={siteMeta.name} />
<meta property="og:locale" content={siteMeta.locale} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={fullImageUrl} />
<meta name="twitter:image:alt" content={seo.imageAlt} />

<!-- Business Contact -->
<meta name="contact" content={siteMeta.email} />
