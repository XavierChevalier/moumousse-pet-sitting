---
import { siteConfig, type SEOConfig } from '../config/SiteConfig'

interface Props extends Partial<SEOConfig> {}

const {
  title = siteConfig.seo.title,
  description = siteConfig.seo.description,
  image = siteConfig.seo.image,
  imageAlt = siteConfig.seo.imageAlt,
  canonical = siteConfig.seo.canonical,
  noindex = siteConfig.seo.noindex,
  nofollow = siteConfig.seo.nofollow,
  type = siteConfig.seo.type,
  author = siteConfig.seo.author,
} = Astro.props

/**
 * Normalizes a canonical URL by:
 * - Removing hash fragments (#)
 * - Removing all query parameters (including UTM - Umami tracks these from the actual page URL, not canonical)
 * - Ensuring trailing slash for HTML routes (matching Astro's trailingSlash: 'always' config)
 * 
 * Note: Astro.url.pathname should already exclude query/hash, but this ensures consistency
 * especially if a canonical prop is passed as a full URL string.
 */
function normalizeCanonicalURL(pathname: string | undefined, baseURL: string): string {
  if (!pathname) {
    return baseURL
  }
  
  // Handle both pathname strings and full URLs
  // If pathname is a full URL, extract just the pathname part
  let cleanPathname: string
  try {
    const url = new URL(pathname, baseURL)
    cleanPathname = url.pathname
  } catch {
    // If it's not a valid URL, treat it as a pathname string
    // Remove hash and query parameters (defensive - pathname shouldn't have these)
    const withoutQuery = pathname.split('?')[0] ?? pathname
    cleanPathname = withoutQuery.split('#')[0] ?? withoutQuery
  }
  
  if (!cleanPathname || cleanPathname === '') {
    return baseURL
  }
  
  // Ensure trailing slash for HTML routes (exclude file extensions like .json, .xml, etc.)
  // Root path should remain as '/'
  const hasFileExtension = /\.\w+$/.test(cleanPathname)
  const normalizedPath = cleanPathname === '/'
    ? '/'
    : hasFileExtension
      ? cleanPathname
      : cleanPathname.endsWith('/')
        ? cleanPathname
        : `${cleanPathname}/`
  
  return new URL(normalizedPath, baseURL).href
}

// Always use the canonical base URL (HTTPS) to avoid http vs https issues
const baseCanonicalURL = siteConfig.seo.url

const canonicalURL = canonical
  ? normalizeCanonicalURL(canonical, baseCanonicalURL)
  : normalizeCanonicalURL(Astro.url.pathname, baseCanonicalURL)

const fullImageUrl = image.startsWith('http') ? image : new URL(image, siteConfig.seo.url).href
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta
  name="keywords"
  content="pet sitting Pélussin, garde animaux Loire 42, dog sitting Pélussin, cat sitter, garde chien domicile, garde chat vacances, promenade chien, pet sitter professionnel, garde NAC, Pilat, Saint-Étienne"
/>
<meta name="author" content={author} />
<link rel="canonical" href={canonicalURL} />
<meta
  name="robots"
  content={[noindex ? 'noindex' : 'index', nofollow ? 'nofollow' : 'follow'].join(', ')}
/>

<!-- Geo Tags -->
<meta name="geo.region" content={siteConfig.seo.location.regionCode} />
<meta name="geo.placename" content={siteConfig.seo.location.city} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content={siteConfig.business.name} />
<meta property="og:locale" content={siteConfig.seo.locale} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Business Contact -->
<meta name="contact" content={siteConfig.contact.email} />
