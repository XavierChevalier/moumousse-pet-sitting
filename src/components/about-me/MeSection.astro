---
import { Picture } from 'astro:assets'
import SteffieOttawa from '../../assets/steffie-ottawa.jpg'
import SectionAnchor from '../ui/SectionAnchor.astro'
import { siteConfig } from '../../config/SiteConfig'

export interface Props extends astroHTML.JSX.HTMLAttributes {
  id: string
}

const { id, ...props } = Astro.props
---

<section {...props} class="bg-tertiary/5 relative px-4 py-20">
  <SectionAnchor id={id} />

  <div class="container mx-auto max-w-7xl">
    <div class="text-center">
      <h2
        class="text-outline text-secondary mb-8 text-center text-3xl font-black uppercase sm:mb-12 sm:text-4xl lg:mb-16 lg:text-6xl"
        data-text="Faisons connaissance"
      >
        Faisons connaissance
      </h2>
    </div>

    <div
      class="bg-body border-4 border-black p-4 text-lg leading-loose shadow-[10px_10px_0px_0px_theme(colors.black)] sm:p-6 lg:gap-8 lg:p-8 lg:text-xl"
    >
      <div class="flex flex-col items-center gap-8 md:inline">
        <Picture
          src={SteffieOttawa}
          alt="Steffie Thollot, pet sitter professionnelle diplômée ACACED avec son chien Ottawa - Moumousse Pet Sitting Pélussin"
          width={350}
          class="pointer-events-none float-left mr-8 select-none"
        />

        <div class="min-h-[520px]">
          <h3 class="text-xl font-bold sm:text-2xl">Pourquoi « Moumousse » ?</h3>

          <p class="mt-4">
            Moumousse a été le <strong>premier chat dont je me suis occupée</strong>, qui en réalité
            était celui de ma voisine. D’aussi loin que je me souvienne, elle me laissait m’en
            occuper comme mon propre chat. Moumousse m'a apporté 17 ans d’amour et de câlins poilus.
          </p>
          <p class="mt-4">
            Une passion et une sensibilité envers les animaux s'est développée tout au long de ma
            vie pour qu’à l’aube de mes 30 ans, je plaque un super travail, décision dur mais
            nécessaire, pour <strong>me consacrer à la cause animale</strong> et le bien-être de nos
            boules de poils.
          </p>
          <p class="mt-4">
            Une expérience en refuge et <strong>la garde d’animaux</strong> dans mon entourage aura donné
            naissance à <strong>{siteConfig.business.name}</strong> qui un jour, je l'espère, deviendra un
            refuge à son tour et un havre de paix pour tous les animaux dans le besoin.
          </p>
        </div>

        <span
          class="mt-4 block w-full text-right text-lg tracking-tight text-black/40 sm:text-xl lg:mt-2"
          >{siteConfig.business.ownerName}</span
        >
      </div>
    </div>
  </div>
</section>
