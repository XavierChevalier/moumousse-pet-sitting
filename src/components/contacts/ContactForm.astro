---
import { Mail, Loader2 } from '@lucide/astro'
import Button from '../ui/Button.astro'
import Alert from '../ui/Alert.astro'
import Input from '../ui/forms/Input.astro'
import Select from '../ui/forms/Select.astro'
import Textarea from '../ui/forms/Textarea.astro'
import Label from '../ui/forms/Label.astro'
import ContactPhoneInfo from './ContactPhoneInfo.astro'
import ProtectedPhone from '../ui/ProtectedPhone.astro'
import PrevisitInfo from './PrevisitInfo.astro'
import { siteConfig } from '../../config/SiteConfig'

export interface Props extends astroHTML.JSX.HTMLAttributes {}
---

<div {...Astro.props} class="mx-auto max-w-2xl">
  <!-- Alert (hidden by default) -->
  <Alert id="contact-success-alert" variant="primary" class="mb-6" hidden>
    <Mail slot="icon" class="mr-2 h-5 w-5" />
    <span slot="title" class="font-bold">Message envoyé avec succès !</span>
    <p class="mt-1 text-sm">Je vous répondrai dans les plus brefs délais.</p>
  </Alert>

  <Alert id="contact-error-alert" variant="error" class="mb-6" hidden>
    <Mail slot="icon" class="mr-2 h-5 w-5" />
    <span slot="title" class="font-bold">Une erreur s’est produite</span>
    <p class="mt-1 text-sm">
      Veuillez me contacter directement par mail ou par SMS.
      <br />
      <a
        href={`mailto:${siteConfig.contact.email}`}
        class="hover:text-primary flex items-center gap-2 transition-colors"
        data-umami-event="contact:click-email-error"
      >
        <Mail width={18} />
        {siteConfig.contact.email}
      </a>
      <ProtectedPhone />
    </p>
  </Alert>

  <!-- Contact Form -->
  <form
    id="contact-form"
    name="contact"
    class="space-y-6"
    data-netlify="true"
    data-netlify-recaptcha="true"
  >
    <input type="hidden" name="form-name" value="contact" />
    <input type="hidden" name="subject" data-remove-prefix value="[%{siteName}] Nouveau message" />

    <!-- Phone alternative (above main CTA) -->
    <ContactPhoneInfo />

    <!-- Topic Dropdown -->
    <div>
      <Label for="topic">Sujet *</Label>
      <Select id="topic" name="topic" required aria-describedby="topic-error">
        <option value="">Choisissez un sujet</option>
        <option value="previsite">Réserver ma pré-visite gratuite</option>
        <option value="garde-domicile">Garde à domicile</option>
        <option value="visite-quotidienne">Visite quotidienne</option>
        <option value="promenade">Promenade</option>
        <option value="tarifs">Tarifs et disponibilités</option>
        <option value="autre">Autre demande</option>
      </Select>
      <span id="topic-error" class="sr-only" role="alert" aria-live="polite"></span>
    </div>

    <!-- Email Field -->
    <div id="email-field">
      <Label for="email">Email *</Label>
      <Input type="email" id="email" name="email" required placeholder="votre@email.com" aria-describedby="email-error" />
      <span id="email-error" class="sr-only" role="alert" aria-live="polite"></span>
    </div>

    <!-- Pre-visit helper (shown when corresponding topic is selected) -->
    <PrevisitInfo id="previsit-info" class="hidden" />

    <!-- Content Textarea -->
    <div id="content-field">
      <Label for="content">Message *</Label>
      <Textarea
        id="content"
        name="content"
        required
        rows={6}
        placeholder="Décrivez votre demande..."
        aria-describedby="content-error"
      />
      <span id="content-error" class="sr-only" role="alert" aria-live="polite"></span>
    </div>

    <!-- Recaptcha (hidden by default) -->
    <div data-netlify-recaptcha="true" class="flex justify-center"></div>

    <!-- Submit Button -->
    <div id="submit-wrapper" class="text-center">
      <Button
        variant="filled"
        size="large"
        type="submit"
        id="contact-submit-btn"
        data-umami-event="contact:submit-form"
      >
        <span id="contact-submit-text">Envoyer le message</span>
        <Loader2 id="contact-submit-spinner" class="hidden h-6 w-6 animate-spin" />
      </Button>
    </div>
  </form>
</div>

<script>
  function showAlert(alert: HTMLElement) {
    alert.classList.remove('hidden')
    alert.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
  }

  function clearFieldErrors() {
    const errorElements = ['topic-error', 'email-error', 'content-error']
    errorElements.forEach((id) => {
      const errorEl = document.getElementById(id)
      if (errorEl) {
        errorEl.textContent = ''
        errorEl.classList.add('sr-only')
      }
    })
  }

  function setFieldError(fieldId: string, errorId: string, message: string) {
    const field = document.getElementById(fieldId) as HTMLElement
    const errorEl = document.getElementById(errorId) as HTMLElement
    if (field && errorEl) {
      field.setAttribute('aria-invalid', 'true')
      errorEl.textContent = message
      errorEl.classList.remove('sr-only')
      errorEl.classList.add('mt-1', 'text-sm', 'font-bold', 'text-red-600')
    }
  }

  function clearFieldError(fieldId: string, errorId: string) {
    const field = document.getElementById(fieldId) as HTMLElement
    const errorEl = document.getElementById(errorId) as HTMLElement
    if (field && errorEl) {
      field.removeAttribute('aria-invalid')
      errorEl.textContent = ''
      errorEl.classList.add('sr-only')
      errorEl.classList.remove('mt-1', 'text-sm', 'font-bold', 'text-red-600')
    }
  }

  /**
   * Validates the contact form before submission
   * 
   * Checks that all required fields are filled and valid:
   * - Topic: must be selected
   * - Email: must be filled and valid (email format)
   * - Message (content): must be filled (non-empty after trim)
   * 
   * Displays validation errors for each invalid field.
   * 
   * @param form - HTML form element to validate
   * @returns `true` if the form is valid, `false` otherwise
   */
  function validateForm(form: HTMLFormElement): boolean {
    clearFieldErrors()
    let isValid = true

    const topic = form.querySelector('#topic') as HTMLSelectElement
    if (topic && !topic.value) {
      setFieldError('topic', 'topic-error', 'Veuillez sélectionner un sujet')
      isValid = false
    }

    const email = form.querySelector('#email') as HTMLInputElement
    if (email) {
      if (!email.value) {
        setFieldError('email', 'email-error', 'Veuillez saisir votre adresse email')
        isValid = false
      } else if (!email.validity.valid) {
        setFieldError('email', 'email-error', 'Veuillez saisir une adresse email valide')
        isValid = false
      }
    }

    const content = form.querySelector('#content') as HTMLTextAreaElement
    if (content && !content.value.trim()) {
      setFieldError('content', 'content-error', 'Veuillez saisir votre message')
      isValid = false
    }

    return isValid
  }

  /**
   * Submits the contact form via Netlify Forms
   * 
   * Handles asynchronous form submission:
   * 1. Validates the form before submission
   * 2. Displays a loading state (spinner)
   * 3. Sends data via POST to Netlify
   * 4. Displays a success or error message
   * 5. Resets the form on success
   * 
   * @param event - Form submission event
   */
  function submitForm(event: SubmitEvent) {
    event.preventDefault()

    const form = event.target as HTMLFormElement
    const submitButton = document.getElementById('contact-submit-btn') as HTMLButtonElement
    const submitText = document.getElementById('contact-submit-text') as HTMLSpanElement
    const submitSpinner = document.getElementById('contact-submit-spinner') as HTMLElement
    const successAlert = document.getElementById('contact-success-alert') as HTMLElement
    const errorAlert = document.getElementById('contact-error-alert') as HTMLElement

    // Validate form before submission
    if (!validateForm(form)) {
      // Focus on first error field
      const firstError = form.querySelector('[aria-invalid="true"]') as HTMLElement
      if (firstError) {
        firstError.focus()
      }
      return
    }

    // Show spinner, hide text
    submitText.classList.add('hidden')
    submitSpinner.classList.remove('hidden')
    submitButton.disabled = true

    const formData = new FormData(event.target as HTMLFormElement)
    fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(formData as unknown as URLSearchParams).toString(),
    })
      .then(() => {
        // Hide spinner, show text
        submitText.classList.remove('hidden')
        submitSpinner.classList.add('hidden')
        submitButton.disabled = false

        showAlert(successAlert)
        form.reset()
        clearFieldErrors()
      })
      .catch((error) => {
        console.error('Error submitting form:', error)
        showAlert(errorAlert)
        submitText.classList.remove('hidden')
        submitSpinner.classList.add('hidden')
        submitButton.disabled = false
      })
  }

  function updatePrevisitInfoVisibility(topicSelect: HTMLSelectElement) {
    const previsitInfo = document.getElementById('previsit-info') as HTMLElement | null
    const emailField = document.getElementById('email-field') as HTMLElement | null
    const contentField = document.getElementById('content-field') as HTMLElement | null
    const submitWrapper = document.getElementById('submit-wrapper') as HTMLElement | null
    if (!previsitInfo || !emailField || !contentField || !submitWrapper) return

    const isPrevisit = topicSelect.value === 'previsite'
    previsitInfo.classList.toggle('hidden', !isPrevisit)
    emailField.classList.toggle('hidden', isPrevisit)
    contentField.classList.toggle('hidden', isPrevisit)
    submitWrapper.classList.toggle('hidden', isPrevisit)
  }

  document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('contact-form') as HTMLFormElement
    const topicSelect = document.getElementById('topic') as HTMLSelectElement
    const emailInput = document.getElementById('email') as HTMLInputElement
    const contentInput = document.getElementById('content') as HTMLTextAreaElement
    const subjectInput = form.querySelector('input[name="subject"]') as HTMLInputElement

    updatePrevisitInfoVisibility(topicSelect)
    topicSelect.addEventListener('change', () => {
      updatePrevisitInfoVisibility(topicSelect)
      clearFieldError('topic', 'topic-error')
    })
    form.addEventListener('submit', submitForm)

    // Clear errors on input
    emailInput.addEventListener('input', () => {
      if (emailInput.value) {
        subjectInput.value = `Contact ${emailInput.value}`
      }
      if (emailInput.validity.valid) {
        clearFieldError('email', 'email-error')
      }
    })

    contentInput.addEventListener('input', () => {
      if (contentInput.value.trim()) {
        clearFieldError('content', 'content-error')
      }
    })
  })
</script>
