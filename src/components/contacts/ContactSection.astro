---
import SectionAnchor from '../ui/SectionAnchor.astro'
import ContactForm from './ContactForm.astro'
import ContactAlternatives from './ContactAlternatives.astro'
import { siteConfig } from '../../config/SiteConfig'

export interface Props extends astroHTML.JSX.HTMLAttributes {
  id: string
}

const { id, ...props } = Astro.props
const formEnabled = siteConfig.contact.formEnabled
---

<section
  {...props}
  class="relative px-4 py-12 contain-[layout_paint] [contain-intrinsic-size:auto_1000px] [content-visibility:auto] sm:py-16 lg:py-20"
>
  <SectionAnchor id={id} />

  <div class="container mx-auto max-w-7xl">
    <div class="text-center">
      <h2
        class="text-outline text-secondary mb-8 text-center text-3xl font-black uppercase sm:mb-12 sm:text-4xl lg:mb-16 lg:text-6xl"
        data-text="Contact"
      >
        Contact
      </h2>
    </div>

    {formEnabled ? <ContactForm /> : <ContactAlternatives />}
  </div>
</section>
