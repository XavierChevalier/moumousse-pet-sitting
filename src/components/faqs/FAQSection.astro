---
import { AlertTriangle, Mail, Phone } from '@lucide/astro'
import { Picture } from 'astro:assets'
import MoumousseDog from '../../assets/moumousse-dog.webp'
import Accordion from '../ui/Accordion.astro'
import AccordionItem from '../ui/AccordionItem.astro'
import ProtectedContent from '../ui/ProtectedContent.astro'
import SectionAnchor from '../ui/SectionAnchor.astro'

export interface Props extends astroHTML.JSX.HTMLAttributes {
  id: string
}

const { id, ...props } = Astro.props
---

<section {...props} class="relative px-4 py-12 sm:py-16 lg:py-20">
  <SectionAnchor id={id} />

  <div class="container mx-auto max-w-7xl">
    <div class="text-center">
      <h2
        class="text-outline text-secondary mb-8 text-center text-3xl font-black uppercase sm:mb-12 sm:text-4xl lg:mb-16 lg:text-6xl"
        data-text="FAQ"
      >
        FAQ
      </h2>
    </div>

    <div class="flex flex-col items-center gap-8 lg:flex-row lg:items-end lg:gap-0">
      <Accordion class="w-full lg:w-3/5">
        <AccordionItem isOpen={true}>
          <span slot="header">Quels animaux je garde ?</span>
          <p class="mb-4">
            Je m'occupe des <strong>chats, chiens et NAC</strong> (nouveaux animaux de compagnie).
          </p>
          <p>
            Cela inclut les lapins, cochons d'Inde, furets, rongeurs, oiseaux, poissons, etc. N'hésitez pas à me contacter pour
            discuter des besoins spécifiques de votre animal.
          </p>
        </AccordionItem>

        <AccordionItem>
          <span slot="header">Quels sont mes services ?</span>
          <ul class="space-y-4">
            <li>
              <strong>Visites à domicile :</strong> soins, nourriture, nettoyage, câlins, jeux, etc.
            </li>
            <li>
              <strong>Promenades :</strong> sorties individuelles ou personnalisées selon les besoins
              du chien.
            </li>
            <li>
              <strong>Présence / compagnie :</strong> rester un moment avec l'animal pour éviter l'ennui
              ou l'anxiété.
            </li>
          </ul>
        </AccordionItem>

        <AccordionItem>
          <span slot="header">Quels sont les tarifs ?</span>
          <p class="mb-4">
            Les tarifs varient selon la formule choisie, le temps passé et la distance.
          </p>
          <p class="mb-4">
            Retrouvez tous les détails dans la section <a
              href="/#services"
              class="text-primary hover:underline">Services</a
            >.
          </p>
          <p>
            Pour un devis personnalisé, <a href="/#contact" class="text-primary hover:underline"
              >contactez-moi</a
            > directement.
          </p>
        </AccordionItem>

        <AccordionItem>
          <span slot="header">Comment réserver ?</span>
          <p class="mb-4">
            Par <strong>mail</strong>, <strong>SMS</strong> ou <strong>appel téléphonique</strong>.
          </p>
          <p class="flex items-center gap-4 leading-tight">
            <AlertTriangle class="h-5 w-5 text-yellow-400" />
            Un premier rendez-vous de rencontre est toujours recommandé avant toute garde.
          </p>
        </AccordionItem>

        <AccordionItem>
          <span slot="header">Comment se passe le règlement ?</span>
          <p class="mb-4">
            Le paiement se fait en amont ou le jour-même de la prestation, selon la formule. Modes
            de paiement acceptés :
          </p>

          <ul class="mb-4 list-inside list-disc">
            <li>Espèces</li>
            <li>Virement bancaire</li>
          </ul>

          <p>
            Une facture peut être fournie sur demande. Pour les gardes longues ou récurrentes, un
            acompte peut être demandé.
          </p>
        </AccordionItem>

        <AccordionItem>
          <span slot="header">Ai-je une formation ?</span>
          <p class="mb-4">Oui, je suis titulaire de :</p>
          <ul class="space-y-3">
            <li>
              <strong>ACACED</strong> (Attestation de Connaissances pour les Animaux de Compagnie d'Espèces
              Domestiques) – Chien, Chat & NAC (rongeurs, lapins, furets, oiseaux, poissons)
            </li>
            <li>
              <strong>Formation de premiers secours canin/félin :</strong> pour réagir vite en cas d'urgence.
            </li>
          </ul>
        </AccordionItem>

        <AccordionItem>
          <span slot="header">Et si mon animal tombe malade ou se blesse ?</span>
          <ul class="space-y-3">
            <li>
              Je contacte votre <strong>vétérinaire habituel</strong> en priorité.
            </li>
            <li>
              En cas d'urgence, j'appelle le <strong>vétérinaire le plus proche</strong>.
            </li>
            <li>
              Vous êtes <strong>informé·e en temps réel</strong> de la situation.
            </li>
          </ul>
        </AccordionItem>

        <AccordionItem>
          <span slot="header">Une question ? Un souci ?</span>
          <p class="mb-4">Contactez-moi sans hésiter :</p>
          <div class="space-y-2">
            <a
              href="mailto:contact@moumousse-pet-sitting.fr"
              class="hover:text-primary flex items-center gap-2 transition-colors"
            >
              <Mail width={18} />
              contact@moumousse-pet-sitting.fr
            </a>
            <ProtectedContent
              encodedContent="MDYgNDYgNDcgMzAgMTE="
              placeholder="Cliquez pour voir le téléphone"
              contentType="phone"
            >
              <Phone slot="prepend" width={18} />
            </ProtectedContent>
          </div>
        </AccordionItem>
      </Accordion>

      <div class="flex w-full justify-center lg:w-2/5 lg:justify-end">
        <Picture
          src={MoumousseDog}
          formats={['avif', 'webp']}
          alt="Moumousse Pet Sitting logo"
          width={300}
          class="pointer-events-none w-32 select-none sm:w-40 lg:w-auto"
        />
      </div>
    </div>
  </div>
</section>
