---
import { Image, getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { cn } from '../../core/tailwindcn'
import { buildLightboxItems } from './buildLightboxItems'
import GalleryEmblaLightbox from './GalleryEmblaLightbox.astro'

export interface Props extends astroHTML.JSX.HTMLAttributes {
  /** Rows: each row is slides left to right. */
  rows: { img: ImageMetadata; title: string; subtitle?: string }[][]
}

type GalleryImage = {
  img: ImageMetadata & { src: string }
  title: string
  subtitle?: string
}

/**
 * Lightbox order (`data-index`): flatten rows top to bottom; within each row, left to right (DOM slide order).
 */
const { rows, class: className, ...props } = Astro.props
const images = rows.flat() as GalleryImage[]

const imageAltSuffix = 'Animal gardé par Moumousse Pet Sitting à Pélussin et alentours'

const highResResults = await Promise.all(
  images.map(({ img }) => getImage({ src: img, width: 1920, format: 'webp', quality: 80 }))
)
const highResSources = highResResults.map((r) => r.src)
const thumbResults = await Promise.all(
  images.map(({ img }) =>
    getImage({ src: img, width: 128, height: 128, format: 'webp', quality: 70 })
  )
)
const thumbSources = thumbResults.map((r) => r.src)

let nextGlobalIndex = 0
const rowsWithIndex = rows.map((row) =>
  row.map((item) => ({ ...item, globalIndex: nextGlobalIndex++ }))
)

const lightboxItems = buildLightboxItems({
  images,
  highResSources,
  thumbSources,
  imageAltSuffix,
})
---

<div {...props} id="gallery-embla-root" class={cn('w-full', className)}>
  <div
    class="relative w-full space-y-4 py-8 select-none sm:space-y-5 sm:py-12 md:py-16 lg:space-y-6 lg:py-20"
  >
    {
      rowsWithIndex.map((row) => (
        <div class="w-full" data-gallery-row>
          <div
            class="gallery-embla__viewport w-full touch-pan-x overflow-x-auto overflow-y-hidden"
            data-gallery-viewport
          >
            <div class="gallery-embla__container flex flex-row gap-4 px-4 sm:gap-5 sm:px-6 md:gap-6 lg:gap-8 lg:px-8">
              {row.map(({ img, title, subtitle, globalIndex }) => (
                <div
                  class="gallery-lightbox-item min-w-[min(78vw,16rem)] shrink-0 select-none sm:min-w-[18rem] lg:min-w-[20rem]"
                  data-index={globalIndex}
                  data-title={title}
                  data-subtitle={subtitle || ''}
                >
                  <div class="group relative cursor-zoom-in overflow-hidden rounded-lg">
                    <Image
                      src={img}
                      class="pointer-events-none h-52 w-full object-cover object-left-top select-none sm:h-64 lg:h-72"
                      height="400"
                      width="400"
                      alt={`${title} - ${imageAltSuffix}`}
                      draggable={false}
                      loading="lazy"
                      layout="fixed"
                    />

                    <div class="bg-opacity-50 group-hover:bg-secondary/15 absolute inset-0 flex items-end justify-center py-3 text-center font-bold text-white opacity-0 transition-all group-hover:opacity-100 sm:py-4">
                      <div>
                        <div class="text-lg sm:text-xl lg:text-2xl">{title}</div>
                        {subtitle && <div class="text-sm sm:text-base lg:text-lg">{subtitle}</div>}
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <GalleryEmblaLightbox items={lightboxItems} />
</div>

<script>
  import { scheduleGalleryEmblaInit } from '../../scripts/gallery-embla-init'
  import { initGalleryEmblaLightbox } from '../../scripts/gallery-embla-lightbox'

  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('gallery-embla-root')
    if (!root) return
    scheduleGalleryEmblaInit(root)
    initGalleryEmblaLightbox(root)
  })
</script>

<style>
  [data-gallery-lightbox] .gallery-lightbox__parallax__img {
    backface-visibility: hidden;
    transform: translateZ(0);
  }

  /* No text/image selection or native image drag on gallery UI */
  #gallery-embla-root .gallery-embla__viewport :where(img),
  #gallery-embla-root .gallery-embla__viewport .gallery-embla-clone {
    -webkit-user-drag: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  [data-gallery-lightbox] [data-lightbox-thumbs] img {
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
  }
</style>
