---
import { Image, getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { cn } from '../../core/tailwindcn'
import Button from '../ui/Button.astro'

export interface Props extends astroHTML.JSX.HTMLAttributes {
  images: { img: ImageMetadata; title: string; subtitle?: string }[]
}

const { images, class: className, ...props } = Astro.props

// Generate low-quality preview images (LQIP) for the lightbox stage only
const previewResults = await Promise.all(
  images.map(({ img }) => getImage({ src: img, width: 24, format: 'webp', quality: 20 }))
)
const lqipSources = previewResults.map((r) => r.src)

// Generate responsive, DPR-aware lightbox srcsets (AVIF/WEBP/JPEG)
const widths = [1024, 1440, 1920]
const quality = 85
const avifSrcsets: string[] = []
const webpSrcsets: string[] = []
const jpegSrcsets: string[] = []
const jpegLargest: string[] = []

for (const { img } of images) {
  const avifUrls = await Promise.all(widths.map((w) => getImage({ src: img, width: w, format: 'avif', quality }).then((r) => r.src)))
  const webpUrls = await Promise.all(widths.map((w) => getImage({ src: img, width: w, format: 'webp', quality }).then((r) => r.src)))
  const jpegUrls = await Promise.all(widths.map((w) => getImage({ src: img, width: w, format: 'jpeg', quality }).then((r) => r.src)))
  avifSrcsets.push(avifUrls.map((u, i) => `${u} ${widths[i]}w`).join(', '))
  webpSrcsets.push(webpUrls.map((u, i) => `${u} ${widths[i]}w`).join(', '))
  jpegSrcsets.push(jpegUrls.map((u, i) => `${u} ${widths[i]}w`).join(', '))
  jpegLargest.push(jpegUrls[jpegUrls.length - 1])
}

const third = Math.ceil(images.length / 3)
const columns = [images.slice(0, third), images.slice(third, 2 * third), images.slice(2 * third)]
---

<div {...props} id="gallery-parallax-container" class={cn(`w-full`, className)}>
  <div
    class="mx-auto grid max-w-7xl grid-cols-1 items-start gap-4 px-4 py-12 sm:gap-6 sm:px-6 sm:py-16 md:grid-cols-3 md:gap-8 md:px-8 lg:grid-cols-3 lg:gap-10 lg:px-10 lg:py-20"
  >
    {
      columns.map((column, columnIndex) => (
        <div class="grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-1 md:gap-8 lg:gap-10">
          {column.map(({ img, title, subtitle }, imageIndex) => {
            const globalIndex = columnIndex * third + imageIndex
            return (
              <div
                class:list={{
                  'parallax-item': true,
                  'parallax-item-on-first-column': columnIndex === 0,
                  'parallax-item-on-third-column': columnIndex === 2,
                  'hidden md:block': globalIndex >= 4,
                }}
                data-index={globalIndex}
                data-preview={lqipSources[globalIndex]}
                data-title={title}
              >
                <div class="group relative overflow-hidden rounded-lg">
                  <Image
                    src={img}
                    class="w-full gap-10 object-cover object-left-top sm:h-72 lg:h-80"
                    height="400"
                    width="400"
                    alt="thumbnail"
                    loading="lazy"
                    layout="fixed"
                  />

                  <div class="bg-opacity-50 group-hover:bg-secondary/15 absolute inset-0 flex items-end justify-center py-3 text-center font-bold text-white opacity-0 transition-all group-hover:opacity-100 sm:py-4">
                    <div>
                      <div class="text-lg sm:text-xl lg:text-2xl">{title}</div>
                      {subtitle && <div class="text-sm sm:text-base lg:text-lg">{subtitle}</div>}
                    </div>
                  </div>
                </div>
              </div>
            )
          })}
        </div>
      ))
    }
  </div>

  <!-- Show More Button -->
  <div class="flex justify-center pb-8 md:hidden">
    <Button id="gallery-show-more-btn" size="large"> Afficher plus </Button>
  </div>

  <!-- Fullscreen Lightbox -->
  <div id="lightbox-overlay" class="fixed inset-0 z-[60] hidden touch-pan-y">
    <div
      id="lightbox-backdrop"
      class="absolute inset-0 bg-black/90 opacity-0 transition-opacity duration-200 will-change-opacity"
    ></div>

    <!-- Close button -->
    <button
      id="lightbox-close"
      aria-label="Fermer"
      class="absolute top-4 right-4 z-[62] h-10 w-10 rounded-full bg-black/60 text-white opacity-0 transition-opacity duration-200"
    >
      ✕
    </button>

    <!-- Prev/Next controls -->
    <button
      id="lightbox-prev"
      aria-label="Précédent"
      class="absolute left-4 top-1/2 z-[62] -translate-y-1/2 flex h-12 w-12 items-center justify-center rounded-full bg-black/60 text-white opacity-0 transition-opacity duration-200"
    >
      ‹
    </button>
    <button
      id="lightbox-next"
      aria-label="Suivant"
      class="absolute right-4 top-1/2 z-[62] -translate-y-1/2 flex h-12 w-12 items-center justify-center rounded-full bg-black/60 text-white opacity-0 transition-opacity duration-200"
    >
      ›
    </button>

    <!-- Stage -->
    <div
      id="lightbox-stage"
      class="absolute inset-0 z-[61] flex items-center justify-center overflow-hidden"
    >
      <div id="lightbox-image-wrapper" class="relative h-full w-full">
        <div
          id="lightbox-frame"
          class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-md shadow-xl"
        >
          <picture id="lightbox-picture">
            <source id="lb-src-avif" type="image/avif" />
            <source id="lb-src-webp" type="image/webp" />
            <img
              id="lightbox-image"
              alt="image"
              class="block max-h-[80vh] max-w-[90vw] select-none object-contain opacity-0 transition-opacity duration-200 will-change-transform"
              style="transition: opacity .2s ease-out, filter .15s ease-out;"
            />
          </picture>
        </div>
      </div>
    </div>

    <!-- Thumbnails strip -->
    <div
      id="lightbox-thumbs"
      class="absolute inset-x-0 bottom-0 z-[62] max-h-[30vh] translate-y-0 bg-black/40 backdrop-blur-sm transition-transform duration-250 will-change-transform"
    >
      <div class="mx-auto flex max-w-7xl gap-2 overflow-x-auto p-3">
        {images.map(({ img }, idx) => (
          <img
            src={(img as any).src}
            data-thumb-index={idx}
            class="h-16 w-16 shrink-0 cursor-pointer rounded object-cover opacity-75 ring-2 ring-transparent transition-all duration-150"
            alt="miniature"
            loading="lazy"
          />
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  import { useResponsive } from '../../core/Responsive'

  // Parallax effect
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('gallery-parallax-container') as HTMLElement
    if (!container) return

    const firstItems = container.querySelectorAll('.parallax-item-on-first-column')
    const thirdItems = container.querySelectorAll('.parallax-item-on-third-column')

    function applyTransform(
      element: HTMLElement,
      translateX: number,
      translateY: number,
      rotateZ: number
    ) {
      element.style.transform = `translateY(${translateY}px) translateX(${translateX}px) rotateZ(${rotateZ}deg)`
    }

    const responsive = useResponsive()
    function updateParallax() {
      if (responsive.isBelow.md) {
        firstItems.forEach((item) => applyTransform(item as HTMLElement, 0, 0, 0))
        thirdItems.forEach((item) => applyTransform(item as HTMLElement, 0, 0, 0))
        return
      }

      const rect = container.getBoundingClientRect()
      const customOffsetTop = 500

      // Calculate how much of the container is visible and scrolled
      const containerTop = rect.top + customOffsetTop
      const containerBottom = rect.bottom

      const windowHeight = window.innerHeight
      // Only apply parallax when container is in viewport
      if (containerBottom < 0 || containerTop > windowHeight) return

      // Calculate scroll progress based on container position in viewport
      const scrollProgress = Math.max(
        0,
        Math.min(1, (windowHeight - containerTop) / (windowHeight + container.offsetHeight))
      )

      firstItems.forEach((item) =>
        applyTransform(
          item as HTMLElement,
          scrollProgress * -50,
          scrollProgress * -50,
          scrollProgress * -10
        )
      )
      thirdItems.forEach((item) =>
        applyTransform(
          item as HTMLElement,
          scrollProgress * 50,
          scrollProgress * -50,
          scrollProgress * 10
        )
      )
    }

    let ticking = false
    function requestTick() {
      if (!ticking) {
        requestAnimationFrame(updateParallax)
        ticking = true
      }
    }

    window.addEventListener('scroll', () => {
      requestTick()
      ticking = false
    })

    // Initial call
    updateParallax()
  })
</script>

<!-- Embed server-generated srcset data for the lightbox -->
<script type="application/json" id="lb-avif-data">{JSON.stringify(avifSrcsets)}</script>
<script type="application/json" id="lb-webp-data">{JSON.stringify(webpSrcsets)}</script>
<script type="application/json" id="lb-jpeg-data">{JSON.stringify(jpegSrcsets)}</script>
<script type="application/json" id="lb-jpeg-largest">{JSON.stringify(jpegLargest)}</script>

<script>
  // Show more button
  document.addEventListener('DOMContentLoaded', () => {
    const showMoreBtn = document.getElementById('gallery-show-more-btn') as HTMLButtonElement
    if (!showMoreBtn) return

    showMoreBtn.addEventListener('click', () => {
      const parallaxItems = document.querySelectorAll('.parallax-item')
      parallaxItems.forEach((item) => item.classList.remove('hidden'))
      showMoreBtn.classList.add('hidden')
    })
  })
</script>

<script>
  // Fullscreen Lightbox (mobile-first, works on desktop too)
  document.addEventListener('DOMContentLoaded', () => {
    const overlay = document.getElementById('lightbox-overlay') as HTMLDivElement
    const backdrop = document.getElementById('lightbox-backdrop') as HTMLDivElement
    const imgEl = document.getElementById('lightbox-image') as HTMLImageElement
    const prevBtn = document.getElementById('lightbox-prev') as HTMLButtonElement
    const nextBtn = document.getElementById('lightbox-next') as HTMLButtonElement
    const closeBtn = document.getElementById('lightbox-close') as HTMLButtonElement
    const thumbs = document.getElementById('lightbox-thumbs') as HTMLDivElement
    const container = document.getElementById('gallery-parallax-container') as HTMLDivElement

    if (!overlay || !container) return

    const imageItems = Array.from(
      container.querySelectorAll('.parallax-item')
    ) as HTMLDivElement[]

    // Build ordered image src list based on props order (globalIndex)
    const total = imageItems.length
    const sources: string[] = new Array(total).fill('')
    const previewSources: string[] = new Array(total).fill('')
    const avifSets: string[] = new Array(total).fill('')
    const webpSets: string[] = new Array(total).fill('')
    const jpegSets: string[] = new Array(total).fill('')
    const jpegFallback: string[] = new Array(total).fill('')
    imageItems.forEach((item) => {
      const index = Number(item.getAttribute('data-index'))
      const img = item.querySelector('img') as HTMLImageElement
      const preview = item.getAttribute('data-preview') || ''
      if (!Number.isNaN(index) && img) sources[index] = img.currentSrc || img.src
      if (!Number.isNaN(index)) previewSources[index] = preview
    })

    // Map server-generated srcsets for lightbox
    const avifList = JSON.parse(document.getElementById('lb-avif-data')!.textContent || '[]') as string[]
    const webpList = JSON.parse(document.getElementById('lb-webp-data')!.textContent || '[]') as string[]
    const jpegList = JSON.parse(document.getElementById('lb-jpeg-data')!.textContent || '[]') as string[]
    const jpegLargestList = JSON.parse(document.getElementById('lb-jpeg-largest')!.textContent || '[]') as string[]
    for (let i = 0; i < total; i++) {
      avifSets[i] = avifList[i] || ''
      webpSets[i] = webpList[i] || ''
      jpegSets[i] = jpegList[i] || ''
      jpegFallback[i] = jpegLargestList[i] || ''
    }

    let currentIndex = 0
    let scrollLocked = false

    function lockScroll() {
      if (scrollLocked) return
      document.documentElement.style.overflow = 'hidden'
      document.body.style.overflow = 'hidden'
      scrollLocked = true
    }

    function unlockScroll() {
      document.documentElement.style.overflow = ''
      document.body.style.overflow = ''
      scrollLocked = false
    }

    function showOverlay(index: number) {
      currentIndex = index
      updateImage()
      preloadNext()
      overlay.classList.remove('hidden')
      requestAnimationFrame(() => {
        backdrop.style.opacity = '1'
        imgEl.style.opacity = '1'
        prevBtn && (prevBtn.style.opacity = '1')
        nextBtn && (nextBtn.style.opacity = '1')
        closeBtn && (closeBtn.style.opacity = '1')
      })
      highlightThumb()
      lockScroll()
    }

    function hideOverlay() {
      backdrop.style.opacity = '0'
      imgEl.style.opacity = '0'
      prevBtn && (prevBtn.style.opacity = '0')
      nextBtn && (nextBtn.style.opacity = '0')
      closeBtn && (closeBtn.style.opacity = '0')
      setTimeout(() => overlay.classList.add('hidden'), 200)
      unlockScroll()
    }

    function updateImage() {
      const full = sources[currentIndex]
      const preview = previewSources[currentIndex]
      if (!full && !preview) return

      // Start with preview blurred
      if (preview) {
        imgEl.src = preview
        imgEl.style.filter = 'blur(12px)'
        imgEl.style.opacity = '1'
      } else {
        imgEl.style.opacity = '0'
      }

      // Wire picture sources for responsive, DPR-aware loading
      const avifEl = document.getElementById('lb-src-avif') as HTMLSourceElement
      const webpEl = document.getElementById('lb-src-webp') as HTMLSourceElement
      const picture = document.getElementById('lightbox-picture') as HTMLPictureElement
      avifEl.srcset = avifSets[currentIndex]
      webpEl.srcset = webpSets[currentIndex]
      imgEl.srcset = jpegSets[currentIndex]
      imgEl.sizes = '(max-width: 768px) 90vw, (max-width: 1280px) 80vw, 70vw'
      imgEl.src = jpegFallback[currentIndex] || full || imgEl.src

      // When the selected source settles, remove blur
      const candidate = new Image()
      candidate.onload = () => {
        imgEl.style.filter = 'none'
        requestAnimationFrame(() => (imgEl.style.opacity = '1'))
      }
      candidate.src = imgEl.currentSrc || imgEl.src

      highlightThumb()
    }

    // Preload next image for smoother navigation
    function preloadNext() {
      const nextIndex = (currentIndex + 1 + total) % total
      const pre = new Image()
      pre.srcset = avifSets[nextIndex]
      const pre2 = new Image()
      pre2.srcset = webpSets[nextIndex]
      const pre3 = new Image()
      pre3.srcset = jpegSets[nextIndex]
      pre3.sizes = '(max-width: 768px) 90vw, (max-width: 1280px) 80vw, 70vw'
      pre3.src = jpegFallback[nextIndex] || sources[nextIndex]
    }

    function next() {
      currentIndex = (currentIndex + 1 + total) % total
      updateImage()
      preloadNext()
    }
    function prev() {
      currentIndex = (currentIndex - 1 + total) % total
      updateImage()
      preloadNext()
    }

    function highlightThumb() {
      if (!thumbs) return
      const items = thumbs.querySelectorAll('img[data-thumb-index]') as NodeListOf<HTMLImageElement>
      items.forEach((t) => {
        const idx = Number(t.getAttribute('data-thumb-index'))
        if (idx === currentIndex) {
          t.style.opacity = '1'
          t.style.ringColor = ''
          t.classList.add('ring-primary')
        } else {
          t.style.opacity = '0.7'
          t.classList.remove('ring-primary')
        }
      })
      // Ensure active thumb is visible
      const active = thumbs.querySelector(`img[data-thumb-index="${currentIndex}"]`) as HTMLImageElement
      active && active.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' })
    }

    // Click bindings on grid images
    imageItems.forEach((item) => {
      item.style.cursor = 'zoom-in'
      item.addEventListener('click', () => {
        const idx = Number(item.getAttribute('data-index'))
        if (!Number.isNaN(idx)) showOverlay(idx)
      })
    })

    // Controls
    nextBtn && nextBtn.addEventListener('click', next)
    prevBtn && prevBtn.addEventListener('click', prev)
    closeBtn && closeBtn.addEventListener('click', hideOverlay)
    backdrop && backdrop.addEventListener('click', hideOverlay)

    // ESC to close
    document.addEventListener('keydown', (e) => {
      if (overlay.classList.contains('hidden')) return
      if (e.key === 'Escape') hideOverlay()
      if (e.key === 'ArrowRight') next()
      if (e.key === 'ArrowLeft') prev()
    })

    // Thumbs click
    if (thumbs) {
      thumbs.addEventListener('click', (e) => {
        const target = e.target as HTMLElement
        if (target && target.matches('img[data-thumb-index]')) {
          const idx = Number(target.getAttribute('data-thumb-index'))
          if (!Number.isNaN(idx)) {
            currentIndex = idx
            updateImage()
          }
        }
      })
    }

    // Touch gestures for stage (swipe left/right to navigate, swipe down on thumbs to hide)
    let startX = 0
    let startY = 0
    let deltaX = 0
    let deltaY = 0
    const stage = document.getElementById('lightbox-stage') as HTMLDivElement

    function onTouchStart(e: TouchEvent) {
      const t = e.touches[0]
      startX = t.clientX
      startY = t.clientY
      deltaX = 0
      deltaY = 0
    }
    function onTouchMove(e: TouchEvent) {
      const t = e.touches[0]
      deltaX = t.clientX - startX
      deltaY = t.clientY - startY
    }
    function onTouchEnd() {
      const absX = Math.abs(deltaX)
      const absY = Math.abs(deltaY)
      const SWIPE_THRESHOLD = 40
      if (absX > absY && absX > SWIPE_THRESHOLD) {
        if (deltaX < 0) next()
        else prev()
      }
      if (deltaY > SWIPE_THRESHOLD) {
        // Swipe down closes the lightbox
        hideOverlay()
      }
    }

    stage && stage.addEventListener('touchstart', onTouchStart, { passive: true })
    stage && stage.addEventListener('touchmove', onTouchMove, { passive: true })
    stage && stage.addEventListener('touchend', onTouchEnd)
  })
</script>

<style>
  .parallax-item-on-first-column,
  .parallax-item-on-third-column {
    transition: transform 0.1s ease-out;
    will-change: transform;
  }

  /* Optimize for performance */
  .parallax-item-on-first-column img,
  .parallax-item-on-third-column img {
    backface-visibility: hidden;
    transform: translateZ(0);
  }

  /* Lightbox performance hints */
  #lightbox-overlay img {
    backface-visibility: hidden;
    transform: translateZ(0);
  }
</style>
