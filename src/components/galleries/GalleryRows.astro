---
import type { ImageMetadata } from 'astro'
import { cn } from '../../core/tailwindcn'
import { buildGalleryImageSrcs } from './buildGalleryImageSrcs'
import { buildLightboxItems } from './buildLightboxItems'
import type { GalleryRowItem } from './GalleryRow.astro'
import GalleryRow from './GalleryRow.astro'
import GalleryLightbox from './GalleryLightbox.astro'

export interface Props extends astroHTML.JSX.HTMLAttributes {
  /** Rows: each row is slides left to right. */
  rows: { img: ImageMetadata; title: string; subtitle?: string }[][]
}

type GalleryImage = {
  img: ImageMetadata & { src: string }
  title: string
  subtitle?: string
}

/**
 * Lightbox order (`data-index`): flatten rows top to bottom; within each row, left to right (DOM slide order).
 */
const { rows, class: className, ...props } = Astro.props
const images = rows.flat() as GalleryImage[]

const { lightboxFullSrcs, lightboxThumbSrcs, cardLqipSrcs } = await buildGalleryImageSrcs(images)

let nextGlobalIndex = 0
const rowsWithIndex: GalleryRowItem[][] = rows.map((row) =>
  row.map((item) => {
    const idx = nextGlobalIndex++
    return {
      ...item,
      globalIndex: idx,
      lightboxFullSrc: lightboxFullSrcs[idx]!,
      cardLqipSrc: cardLqipSrcs[idx]!,
    }
  })
)

const lightboxItems = buildLightboxItems({
  images,
  lightboxFullSrcs,
  lightboxThumbSrcs,
  cardLqipSrcs,
})
---

<div {...props} id="gallery-embla-root" class={cn('w-full', className)}>
  <div
    class="relative w-full space-y-4 py-8 select-none sm:space-y-5 sm:py-12 md:py-16 lg:space-y-6 lg:py-20"
  >
    {rowsWithIndex.map((row) => <GalleryRow row={row} />)}
  </div>

  <GalleryLightbox items={lightboxItems} />
</div>

<script>
  import { scheduleGalleryEmblaInit } from '../../scripts/gallery-embla-init'
  import { initGalleryEmblaLightbox } from '../../scripts/gallery-embla-lightbox'

  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('gallery-embla-root')
    if (!root) return
    scheduleGalleryEmblaInit(root)
    initGalleryEmblaLightbox(root)

    const markLoaded = (img: HTMLImageElement) => {
      img.dataset.loaded = 'true'
    }

    // Images can be cloned/inserted after DOMContentLoaded (Embla).
    // `load` doesn't bubble, so we listen in capture phase to catch late images too.
    root.addEventListener(
      'load',
      (e) => {
        const t = e.target
        if (t instanceof HTMLImageElement && t.classList.contains('gallery-blur-img')) markLoaded(t)
      },
      true
    )

    // Initial pass for images already in cache.
    root.querySelectorAll<HTMLImageElement>('.gallery-blur-img').forEach((img) => {
      if (img.complete && img.naturalWidth > 0) markLoaded(img)
    })

    const preloaded = new Set<string>()
    const preloadLightboxFull = (item: HTMLElement) => {
      const url = item.dataset.lightboxFullSrc
      if (!url || preloaded.has(url)) return
      preloaded.add(url)
      const link = document.createElement('link')
      link.rel = 'prefetch'
      link.as = 'image'
      link.href = url
      document.head.appendChild(link)
    }
    root.querySelectorAll<HTMLElement>('.gallery-lightbox-item').forEach((item) => {
      item.addEventListener('pointerenter', () => preloadLightboxFull(item), { passive: true })
    })
  })
</script>

<style>
  [data-gallery-lightbox] .gallery-lightbox__parallax__img {
    backface-visibility: hidden;
    transform: translateZ(0);
  }

  /* No text/image selection or native image drag on gallery UI */
  #gallery-embla-root .gallery-embla__viewport :where(img),
  #gallery-embla-root .gallery-embla__viewport .gallery-embla-clone {
    -webkit-user-drag: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  [data-gallery-lightbox] [data-lightbox-thumbs] img {
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
  }
</style>
