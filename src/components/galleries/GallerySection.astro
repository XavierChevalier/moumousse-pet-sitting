---
import Bene from '../../assets/gallery/bene.jpeg'
import Bobby from '../../assets/gallery/bobby.jpg'
import DoubleFaceHailey from '../../assets/gallery/double-face-hailey.webp'
import Fiona from '../../assets/gallery/fiona.jpeg'
import Ginger from '../../assets/gallery/ginger.webp'
import Gipsy from '../../assets/gallery/gipsy.jpeg'
import KyonBlizGlobulOdin from '../../assets/gallery/kyon-bliz-globul-odin.jpeg'
import Luna from '../../assets/gallery/luna.jpg'
import Maki from '../../assets/gallery/maki.jpeg'
import Mambo from '../../assets/gallery/mambo.jpg'
import Mistigri from '../../assets/gallery/mistigri.jpg'
import Moumousse from '../../assets/gallery/moumousse.jpg'
import Naska from '../../assets/gallery/naska.webp'
import OttawaLeika from '../../assets/gallery/ottawa-leika.jpg'
import PaleoEtSacha from '../../assets/gallery/paleo-et-sacha.jpg'
import Soul from '../../assets/gallery/soul.jpg'
import Tiska from '../../assets/gallery/tiska.jpg'
import TsukiSun from '../../assets/gallery/tsuki-sun.webp'
import Wisty from '../../assets/gallery/wisty.jpg'
import Zoom from '../../assets/gallery/zoom.webp'
import Zuri from '../../assets/gallery/zuri.jpeg'
import SectionAnchor from '../ui/SectionAnchor.astro'
import GalleryRows from './GalleryRows.astro'

export interface Props extends astroHTML.JSX.HTMLAttributes {
  id: string
}

const galleryRows = [
  [
    { img: Moumousse, title: 'Moumousse' },
    { img: Naska, title: 'Naska' },
    { img: Mambo, title: 'Mambo' },
    { img: DoubleFaceHailey, title: 'Double-Face & Hailey' },
    { img: TsukiSun, title: 'Tsuki' },
    { img: Bobby, title: 'Bobby' },
    { img: Bene, title: 'Bene' },
  ],
  [
    { img: OttawaLeika, title: 'Ottawa & Leïka', subtitle: 'mes 2 amours' },
    { img: Ginger, title: 'Ginger' },
    { img: Zoom, title: 'Zoom' },
    { img: Luna, title: 'Luna' },
    { img: KyonBlizGlobulOdin, title: 'Kyon Bliz Globul Odin' },
    { img: Maki, title: 'Maki' },
    { img: Zuri, title: 'Zuri' },
  ],
  [
    { img: Wisty, title: 'Wisty' },
    { img: Mistigri, title: 'Mistigri' },
    { img: Fiona, title: 'Fiona' },
    { img: Tiska, title: 'Tiska' },
    { img: PaleoEtSacha, title: 'Paleo & Sacha' },
    { img: Gipsy, title: 'Gipsy' },
    { img: Soul, title: 'Soul' },
  ],
]

const { id, ...props } = Astro.props
---

<section {...props} class="relative overflow-x-hidden pt-12 sm:pt-16 lg:pt-20">
  <SectionAnchor id={id} />

  <div class="container mx-auto max-w-7xl px-4">
    <div class="text-center">
      <h2
        class="text-outline text-secondary mb-8 text-center text-3xl font-black uppercase sm:mb-12 sm:text-4xl lg:mb-16 lg:text-6xl"
        data-text="Galerie"
      >
        Galerie
      </h2>
    </div>
  </div>

  <GalleryRows rows={galleryRows} />
</section>
