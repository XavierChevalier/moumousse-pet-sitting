---
import ContactForm from '../contacts/ContactForm.astro'

export interface Props extends astroHTML.JSX.HTMLAttributes {}
---

<section {...Astro.props} class="px-4 py-12 sm:py-16 lg:py-20">
  <div class="container mx-auto max-w-7xl">
    <div class="text-center">
      <h2
        class="text-outline text-secondary mb-8 text-center text-3xl font-black uppercase sm:mb-12 sm:text-4xl lg:mb-16 lg:text-6xl"
        data-text="Contact"
      >
        Contact
      </h2>
    </div>

    <ContactForm />
  </div>
</section>
