---
import MoumousseMalisse from '../../assets/moumousse-malisse.webp'
import PunkBackground from '../ui/PunkBackground.astro'
import { Picture } from 'astro:assets'
import Button from '../ui/Button.astro'

export interface Props extends astroHTML.JSX.HTMLAttributes {}
---

<section
  {...Astro.props}
  class="relative flex min-h-[80dvh] flex-col justify-center gap-12 px-4 py-20 sm:gap-16 lg:gap-24"
>
  <PunkBackground />

  <div class="relative z-10 container mx-auto max-w-7xl">
    <div class="grid gap-12 sm:gap-16 lg:grid-cols-2 lg:gap-24">
      <div class="space-y-4 text-center lg:text-left">
        <!-- Main Headline -->
        <h1
          class="text-3xl leading-tight font-black tracking-wide text-balance uppercase sm:text-4xl md:text-5xl lg:text-7xl"
        >
          <span
            class="text-outline text-tertiary transform whitespace-nowrap"
            data-text="Faite garder"
          >
            Faite garder
          </span>
          <span
            class="text-outline text-secondary transform whitespace-nowrap"
            data-text="vos animaux"
          >
            vos animaux
          </span>
          <span class="text-outline text-primary transform whitespace-nowrap" data-text="en bonne">
            en bonne
          </span>
          <span class="transform whitespace-nowrap text-black" data-text="compagnie">
            compagnie
          </span>
        </h1>

        <!-- Sub Headline -->
        <p class="text-lg font-bold text-black sm:text-xl">À Pélussin et ses alentours</p>

        <!-- CTA Buttons -->
        <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row lg:justify-start">
          <Button href="#services">Tarifs</Button>
          <Button href="#contact" variant="filled">Contactez-moi</Button>
        </div>
      </div>

      <Picture
        src={MoumousseMalisse}
        formats={['avif', 'webp']}
        alt="Chat malissieux"
        class="pointer-events-none mx-auto w-40 select-none sm:w-48 md:w-80 lg:w-auto"
      />
    </div>
  </div>
</section>
