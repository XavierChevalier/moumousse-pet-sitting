---
import { Picture } from 'astro:assets'
import MoumousseMalisse from '../../assets/moumousse-malisse.webp'
import Button from '../ui/Button.astro'
import PunkBackground from '../ui/PunkBackground.astro'

export interface Props extends astroHTML.JSX.HTMLAttributes {}
---

<section
  {...Astro.props}
  class="relative flex min-h-[calc(100dvh-5rem)] flex-col justify-between gap-8 px-4 py-12 sm:min-h-[80dvh] sm:gap-16 sm:py-20 lg:justify-center lg:gap-24"
>
  <PunkBackground />

  <div class="relative z-10 container mx-auto max-w-7xl">
    <div class="grid gap-8 sm:gap-16 lg:grid-cols-2 lg:gap-24">
      <div class="space-y-2 text-center sm:space-y-4 lg:text-left">
        <!-- Main Headline -->
        <h1
          class="text-3xl leading-tight font-black tracking-wide text-balance uppercase sm:text-4xl md:text-5xl lg:text-7xl"
        >
          <span
            class="text-outline text-tertiary transform whitespace-nowrap"
            data-text="Faites garder"
          >
            Faites garder
          </span>
          <span
            class="text-outline text-secondary transform whitespace-nowrap"
            data-text="vos animaux"
          >
            vos animaux
          </span>
          <span class="text-outline text-primary transform whitespace-nowrap" data-text="en bonne">
            en bonne
          </span>
          <span class="transform whitespace-nowrap text-black" data-text="compagnie">
            compagnie
          </span>
        </h1>

        <!-- Sub Headline -->
        <p class="text-lg font-bold text-black sm:text-xl">À Pélussin et ses alentours</p>

        <!-- CTA Buttons -->
        <div class="mt-6 flex flex-col justify-center gap-3 sm:mt-8 sm:flex-row lg:justify-start">
          <Button
            href="#services"
            size="small"
            class="sm:px-8 sm:py-4 sm:text-base"
            data-umami-event="home:click-tarifs">Tarifs</Button
          >
          <Button
            href="#contact"
            variant="filled"
            size="small"
            class="sm:px-8 sm:py-4 sm:text-base"
            data-umami-event="home:click-contact">Contactez-moi</Button
          >
        </div>
      </div>

      <Picture
        src={MoumousseMalisse}
        formats={['avif', 'webp']}
        alt="Chat roux malicieux - Moumousse Pet Sitting à Pélussin - Garde d'animaux professionnelle"
        class="pointer-events-none mx-auto max-h-[35dvh] w-40 object-contain select-none sm:max-h-none sm:w-48 md:w-80 lg:w-auto"
      />
    </div>
  </div>
</section>
