---
import Button from '../ui/Button.astro'
import { MenuIcon } from '@lucide/astro'
import NavigationLogo from './NavigationLogo.astro'

const isHomePage = Astro.url.pathname === '/'
const resolveAnchorHref = (href: string) => {
  // On the homepage we can keep plain hashes for smooth in-page navigation.
  if (isHomePage) return href

  // If this is an in-page anchor (e.g. "#services"), make it target the homepage.
  if (href.startsWith('#')) return `/${href}`

  return href
}

const anchorNameFromHref = (href: string) => href.replace(/^.*#/, '')

const links = [
  { href: '#services', label: 'Prestations & Tarifs' },
  { href: '#galerie', label: 'Galerie' },
  { href: '#faq', label: 'FAQ' },
]
---

<nav class="bg-body fixed top-0 right-0 left-0 z-50 w-full transform overflow-hidden text-black">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 lg:py-4">
    <!-- Desktop menu -->
    <div class="relative flex h-16 items-center justify-center lg:justify-between">
      <NavigationLogo id="navigation-logo" />

      <!-- Navigation Links -->
      <div class="hidden md:block">
        <div class="ml-10 flex items-center break-keep">
          {
            links.map((link) => (
              <a
                href={resolveAnchorHref(link.href)}
                class="hover:text-primary p-4 text-sm font-bold tracking-wide uppercase transition-colors duration-150"
                data-umami-event={`navigation:click-${anchorNameFromHref(link.href)}`}
              >
                {link.label}
              </a>
            ))
          }

          <!-- Contact Button -->
          <Button
            href={resolveAnchorHref('#contact')}
            size="small"
            class="ml-4"
            data-umami-event="navigation:click-contact"
          >
            Contactez-moi
          </Button>
        </div>
      </div>

      <!-- Mobile menu button -->
      <div class="absolute right-0 md:hidden">
        <button
          type="button"
          id="mobile-menu-button"
          class="hover:text-primary focus:text-primary cursor-pointer transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          aria-label="Menu mobile"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-umami-event="navigation:toggle-mobile-menu"
        >
          <MenuIcon class="h-6 w-6" />
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden h-[calc(100dvh-4rem)] text-xl md:hidden" role="menu" aria-label="Menu de navigation mobile">
      <div class="flex h-full flex-col py-8">
        {
          links.map((link) => (
            <a
              href={resolveAnchorHref(link.href)}
              class="hover:text-primary focus:text-primary block p-8 font-bold tracking-wide uppercase transition-colors duration-150"
              data-umami-event={`navigation:click-${anchorNameFromHref(link.href)}-mobile`}
            >
              {link.label}
            </a>
          ))
        }

        <!-- Contact Button -->
        <Button
          href={resolveAnchorHref('#contact')}
          size="large"
          class="mt-8 text-center"
          data-umami-event="navigation:click-contact-mobile"
        >
          Contactez-moi
        </Button>
      </div>
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenu = document.getElementById('mobile-menu') as HTMLDivElement
    const menuButton = document.getElementById('mobile-menu-button') as HTMLButtonElement
    if (!mobileMenu || !menuButton) return

    let previousFocus: HTMLElement | null = null

    function openMenu() {
      mobileMenu.classList.remove('hidden')
      menuButton.setAttribute('aria-expanded', 'true')
      previousFocus = document.activeElement as HTMLElement
      // Focus first menu item
      const firstLink = mobileMenu.querySelector('a') as HTMLAnchorElement
      if (firstLink) {
        setTimeout(() => firstLink.focus(), 100)
      }
    }

    function closeMenu() {
      mobileMenu.classList.add('hidden')
      menuButton.setAttribute('aria-expanded', 'false')
      // Restore focus to menu button
      if (previousFocus) {
        previousFocus.focus()
        previousFocus = null
      }
    }

    function toggleMenu() {
      const isOpen = !mobileMenu.classList.contains('hidden')
      if (isOpen) {
        closeMenu()
      } else {
        openMenu()
      }
    }

    menuButton.addEventListener('click', toggleMenu)

    // Close menu on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
        closeMenu()
      }
    })

    // Close menu when clicking links or logo
    ;[
      ...document.querySelectorAll('#mobile-menu a, #mobile-menu button'),
      document.getElementById('navigation-logo') as HTMLButtonElement,
    ].forEach((element) => {
      element.addEventListener('click', () => {
        if (!mobileMenu.classList.contains('hidden')) {
          closeMenu()
        }
      })
    })
  })
</script>
