---
import { Image } from 'astro:assets'
import MoumousseDog from '../../assets/moumousse-dog.webp'
import { siteConfig } from '../../config/SiteConfig'

export interface Props extends astroHTML.JSX.HTMLAttributes {}
---

<div {...Astro.props} class="flex-shrink-0">
  <a href="/#" class="group flex items-center gap-3" data-umami-event="navigation:click-logo">
    <Image
      src={MoumousseDog}
      alt={`${siteConfig.business.name} Logo`}
      width={72}
      height={108}
      class="h-[55px] w-auto place-items-start justify-start self-end justify-self-start align-bottom"
      loading="lazy"
    />

    <div
      class="group-hover:text-primary flex flex-col text-xl leading-5 font-black uppercase transition duration-150 group-hover:translate-x-1"
    >
      <span class="text-primary"> Moumousse </span>
      <span> Pet Sitting </span>
    </div>
  </a>
</div>
