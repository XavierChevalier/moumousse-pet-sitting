---
import { HelpCircle } from '@lucide/astro'
import type { PrintableDimensions } from '../../core/printables/dimensions'

interface Props {
  dimensions: PrintableDimensions
  title?: string
  panelId?: string
}

const {
  dimensions,
  title = 'Dimensions (impression / export)',
  panelId = 'dimensions-panel',
} = Astro.props
const {
  dpi,
  finishedWidthMm,
  finishedHeightMm,
  bleedMm,
  safeZoneMm,
  contentPaddingMm,
  totalWithBleedWidthMm,
  totalWithBleedHeightMm,
  safeAreaWidthMm,
  safeAreaHeightMm,
  pageWidthMm,
  pageHeightMm,
  targetWidthPx,
  targetHeightPx,
  pageMarginXmm,
  pageMarginYmm,
} = dimensions
---

<div class="fixed right-4 bottom-4 z-[200]">
  <details
    id={panelId}
    class="group relative rounded-xl border border-black/10 bg-white shadow-lg transition-all group-open:w-[min(calc(92vw-16rem),420px)] group-open:max-w-md"
    aria-labelledby="dimensions-panel-title"
  >
    <summary
      id="dimensions-panel-title"
      class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg p-2 transition-colors outline-none select-none group-open:mb-4 group-open:h-auto group-open:w-auto group-open:justify-start group-open:gap-3 group-open:rounded-lg group-open:px-4 group-open:py-3 group-open:text-base group-open:font-extrabold group-open:tracking-[0.02em] group-open:uppercase hover:bg-gray-50 group-open:hover:bg-transparent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-500 [&::-webkit-details-marker]:hidden [&::marker]:content-['']"
    >
      <HelpCircle class="size-5 text-gray-600 group-open:hidden" aria-hidden="true" />
      <span class="hidden group-open:inline">{title}</span>
    </summary>
    <button
      type="button"
      onclick="event.preventDefault(); event.stopPropagation(); document.getElementById('dimensions-panel')?.toggleAttribute('open')"
      class="absolute right-2 bottom-2 z-10 flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg transition-colors hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-500"
      aria-label="Toggle dimensions panel"
    >
      <HelpCircle class="size-5 text-gray-600" aria-hidden="true" />
    </button>
    <dl
      class="hidden max-h-[70vh] grid-cols-1 gap-x-6 gap-y-3 overflow-auto px-6 pb-6 group-open:grid sm:grid-cols-2 [&_dd]:mt-0.5 [&_dd]:text-[0.95rem] [&_dd]:text-black/90 [&_dt]:text-xs [&_dt]:font-bold [&_dt]:text-black"
    >
      <div>
        <dt>Format fini (cm)</dt>
        <dd>{(finishedWidthMm / 10).toFixed(1)} × {(finishedHeightMm / 10).toFixed(1)} cm</dd>
      </div>
      <div>
        <dt>Format fini (mm)</dt>
        <dd>{finishedWidthMm} × {finishedHeightMm} mm</dd>
      </div>
      <div>
        <dt>Fonds perdus</dt>
        <dd>{bleedMm} mm (chaque côté)</dd>
      </div>
      <div>
        <dt>Total avec fonds perdus</dt>
        <dd>{totalWithBleedWidthMm} × {totalWithBleedHeightMm} mm</dd>
      </div>
      <div>
        <dt>Zone de sécurité (recommandée)</dt>
        <dd>
          {safeZoneMm} mm (chaque côté) → {safeAreaWidthMm} × {safeAreaHeightMm} mm
        </dd>
      </div>
      <div>
        <dt>Padding contenu (dans les composants)</dt>
        <dd>{contentPaddingMm} mm</dd>
      </div>
      <div>
        <dt>Page (mm)</dt>
        <dd>{pageWidthMm.toFixed(3)} × {pageHeightMm.toFixed(3)} mm</dd>
      </div>
      <div>
        <dt>Export raster</dt>
        <dd>
          {targetWidthPx} × {targetHeightPx} px @ {dpi} DPI
        </dd>
      </div>
      <div>
        <dt>Marge (gauche / droite)</dt>
        <dd>{pageMarginXmm.toFixed(3)} mm</dd>
      </div>
      <div>
        <dt>Marge (haut / bas)</dt>
        <dd>{pageMarginYmm.toFixed(3)} mm</dd>
      </div>
      <div>
        <dt>Repères de coupe</dt>
        <dd>Longueur 5mm · Décalage 2mm</dd>
      </div>
      <div>
        <dt>Épaisseur filets mini (quadri)</dt>
        <dd>0.25 pt ≈ 0,088 mm (0.3 pt ≈ 0,106 mm si éléments non aplatis)</dd>
      </div>
      <div>
        <dt>Tolérance de façonnage</dt>
        <dd>± 1 mm</dd>
      </div>
      <div class="sm:col-span-2">
        <dt>Corps min. (rappel)</dt>
        <dd>Sans sérif 6–7pt (12–14pt en négatif) · Sérif 8–9pt (16–18pt en négatif)</dd>
      </div>
    </dl>
  </details>
</div>
