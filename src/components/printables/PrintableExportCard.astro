---
import type { PrintableDimensions } from '../../core/printables/dimensions'

interface Props {
  label: string
  targetId: string
  filename: string
  dimensions: PrintableDimensions
  /** Overlay (crop marks) */
  overlaySrc: string
  /** Whether this face should be visible initially */
  visible?: boolean
}

const { label, targetId, filename, dimensions, overlaySrc, visible = true } = Astro.props
---

<div
  class={`relative flex flex-col items-center gap-4 ${visible ? '' : 'hidden'}`}
  data-face-container={targetId}
>
  <div
    class="relative box-border bg-white px-[var(--page-margin-x)] py-[var(--page-margin-y)] shadow-md"
    id={targetId}
    data-dimensions={JSON.stringify(dimensions)}
    style={`--page-margin-x: ${dimensions.pageMarginXmm}mm; --page-margin-y: ${dimensions.pageMarginYmm}mm;`}
  >
    <slot />

    <img
      src={overlaySrc}
      alt=""
      aria-hidden="true"
      draggable="false"
      class="overlay-image pointer-events-none absolute inset-0 z-10 h-full w-full object-contain select-none"
    />
  </div>
</div>

