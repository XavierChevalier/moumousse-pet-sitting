---
import { Download, Layers, Scissors } from '@lucide/astro'
import type { PrintableDimensions } from '../../core/printables/dimensions'
import Dropdown from '../ui/Dropdown.astro'
import SegmentedControl from '../ui/SegmentedControl.astro'

interface Props {
  dimensions: PrintableDimensions
  currentPage: 'visit-card' | 'flyer'
  currentFaceId?: string
  faces: Array<{ id: string; label: string }>
}

const { dimensions, currentPage, currentFaceId, faces } = Astro.props
---

<div class="fixed top-0 left-0 right-0 z-[100] flex items-center justify-between gap-4 bg-white/95 backdrop-blur-sm border-b border-gray-200 px-4 py-3 shadow-sm" id="printables-toolbar">
  <!-- Page navigation and toggle -->
  <div class="flex items-center gap-2">
    <!-- Dropdown to select page -->
    <Dropdown
      id="page-selector"
      label={currentPage === 'visit-card' ? 'Carte de visite' : 'Flyer'}
      variant={currentPage === 'visit-card' || currentPage === 'flyer' ? 'teal' : 'default'}
      items={[
        {
          label: 'Carte de visite',
          href: '/visit-card/',
          isActive: currentPage === 'visit-card',
        },
        {
          label: 'Flyer',
          href: '/flyer/',
          isActive: currentPage === 'flyer',
        },
      ]}
    />
  </div>

      <!-- Export buttons for the current side -->
      {currentFaceId && (
        <div class="flex items-center gap-3" data-toolbar-face={currentFaceId}>
          <!-- Segmented control for export mode -->
          <SegmentedControl
            id={`export-mode-${currentFaceId}`}
            defaultValue="with-overlay"
            ariaLabel="Mode d'export"
            options={[
              {
                value: 'with-overlay',
                label: 'Avec guides',
                labelShort: 'Guides',
                icon: Layers,
              },
              {
                value: 'without-overlay',
                label: 'Après découpe',
                labelShort: 'Découpe',
                icon: Scissors,
              },
            ]}
          />

          <!-- Primary export button -->
          <button
            class="group relative flex items-center gap-2 rounded-md bg-teal-500 px-4 py-1.5 text-sm font-medium text-white hover:bg-teal-600 transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-500 disabled:cursor-not-allowed disabled:opacity-60 shadow-sm"
            data-target={currentFaceId}
            data-filename={faces.find((f) => f.id === currentFaceId)?.label.toLowerCase().replace(/\s+/g, '-') || 'export'}
            data-with-overlay="true"
            id={`export-button-${currentFaceId}`}
          >
            <Download class="size-4" aria-hidden="true" />
            <span class="hidden sm:inline">Exporter</span>
            <span class="sm:hidden">Export</span>
            <span class="tooltip-dynamic absolute left-1/2 -translate-x-1/2 px-2 py-1 text-xs text-white bg-gray-900 rounded opacity-0 group-hover:opacity-100 pointer-events-none whitespace-nowrap transition-opacity z-50">
              Télécharger l'export ({dimensions.dpi} DPI)
            </span>
          </button>
        </div>
      )}
</div>

<script>
  import type { PrintableDimensions } from '../../core/printables/dimensions'
import { setupPrintablesToolbar } from './behaviors/toolbar'
import { setupPrintableExport } from './export/export-controller'

  setupPrintablesToolbar()

  // Initialize export functionality
  const SCRIPT_INIT_KEY = '__moumousse_printables_toolbar_init__'
  if (!(window as any)[SCRIPT_INIT_KEY]) {
    ;(window as any)[SCRIPT_INIT_KEY] = true

    function init(retries = 10) {
      const container = document.querySelector<HTMLElement>('[data-dimensions]')
      if (container) {
        const dimensionsJson = container.getAttribute('data-dimensions')
        if (dimensionsJson) {
          try {
            const dimensions = JSON.parse(dimensionsJson) as PrintableDimensions
            setupPrintableExport(dimensions)
            return
          } catch (error) {
            console.error('Failed to parse dimensions:', error)
            return
          }
        }
      }

      if (retries > 0) {
        requestAnimationFrame(() => init(retries - 1))
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        requestAnimationFrame(() => init())
      })
    } else {
      requestAnimationFrame(() => init())
    }
  }
</script>
