---
import type { PrintableDimensions } from '../../core/printables/dimensions'

interface Props {
  dimensions: PrintableDimensions
  targetId?: string
}

const { dimensions: _dimensions } = Astro.props
---

<div
  class="pointer-events-none fixed inset-0 z-[95]"
  data-ruler="main"
  style="display: block !important; visibility: visible !important;"
>
  <!-- Corner square at intersection of sidebar and toolbar -->
  <div
    class="ruler-corner"
    style="position: fixed; width: 20px; height: 20px; background-color: #ffffff; border-right: 1px solid #e5e7eb; border-bottom: 1px solid #e5e7eb; z-index: 96; left: 192px; top: 56px;"
  >
  </div>

  <!-- Horizontal Ruler (top) - Canvas -->
  <canvas
    class="ruler-horizontal"
    data-ruler="horizontal"
    style="position: fixed; height: 20px; background-color: #ffffff; border-bottom: 1px solid #e5e7eb; z-index: 95; display: block; left: 192px; top: 56px; right: 0;"
  ></canvas>

  <!-- Vertical Ruler (left) - Canvas -->
  <canvas
    class="ruler-vertical"
    data-ruler="vertical"
    style="position: fixed; width: 20px; background-color: #ffffff; border-right: 1px solid #e5e7eb; z-index: 95; display: block; left: 192px; top: 76px; bottom: 0;"
  ></canvas>

  <!-- Horizontal marker -->
  <div
    class="ruler-marker-horizontal"
    data-marker="horizontal"
    style="position: fixed; width: 2px; height: 20px; background-color: #3b82f6; opacity: 0.9; z-index: 96; display: none; pointer-events: none;"
  >
  </div>

  <!-- Vertical marker -->
  <div
    class="ruler-marker-vertical"
    data-marker="vertical"
    style="position: fixed; width: 20px; height: 2px; background-color: #3b82f6; opacity: 0.9; z-index: 96; display: none; pointer-events: none;"
  >
  </div>

  <!-- Horizontal value display -->
  <div
    class="ruler-value-horizontal"
    data-value="horizontal"
    style="position: fixed; background-color: rgba(107, 114, 128, 0.7); color: white; padding: 1px 3px; font-size: 9px; font-family: monospace; border-radius: 2px; z-index: 97; display: none; pointer-events: none; white-space: nowrap; opacity: 0.8;"
  >
  </div>

  <!-- Vertical value display -->
  <div
    class="ruler-value-vertical"
    data-value="vertical"
    style="position: fixed; background-color: rgba(107, 114, 128, 0.7); color: white; padding: 1px 3px; font-size: 9px; font-family: monospace; border-radius: 2px; z-index: 97; display: none; pointer-events: none; white-space: nowrap; opacity: 0.8;"
  >
  </div>
</div>

<script>
  import { setupPrintablesRuler } from './behaviors/ruler'
  setupPrintablesRuler()
</script>
