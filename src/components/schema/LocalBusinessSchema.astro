---
import { siteConfig } from '../../config/SiteConfig'

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteConfig.seo.url}#business`,
  name: siteConfig.business.name,
  image: `${siteConfig.seo.url}/og-image.png`,
  url: siteConfig.seo.url,
  email: siteConfig.contact.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: siteConfig.seo.location.city,
    addressRegion: siteConfig.seo.location.region,
    postalCode: siteConfig.seo.location.postalCode,
    addressCountry: siteConfig.seo.location.country,
  },
  areaServed: {
    '@type': 'City',
    name: 'Pélussin et alentours',
    containedIn: {
      '@type': 'AdministrativeArea',
      name: siteConfig.seo.location.region,
    },
  },
  founder: {
    '@type': 'Person',
    name: siteConfig.business.ownerName,
  },
  serviceType: ['Pet Sitting', 'Dog Walking', 'Cat Sitting', 'Pet Care'],
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
