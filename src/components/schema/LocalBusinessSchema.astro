---
import { siteMeta } from '../../config/seo'

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteMeta.url}#business`,
  name: siteMeta.businessName,
  image: `${siteMeta.url}/og-image.png`,
  url: siteMeta.url,
  telephone: siteMeta.phone,
  email: siteMeta.email,
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    addressLocality: siteMeta.location.city,
    addressRegion: siteMeta.location.region,
    postalCode: siteMeta.location.postalCode,
    addressCountry: siteMeta.location.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: siteMeta.location.coordinates.latitude,
    longitude: siteMeta.location.coordinates.longitude,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '08:00',
      closes: '20:00',
    },
  ],
  areaServed: {
    '@type': 'City',
    name: 'Pélussin et alentours',
    containedIn: {
      '@type': 'AdministrativeArea',
      name: 'Loire',
    },
  },
  founder: {
    '@type': 'Person',
    name: siteMeta.ownerName,
  },
  serviceType: ['Pet Sitting', 'Dog Walking', 'Cat Sitting', 'Pet Care'],
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
