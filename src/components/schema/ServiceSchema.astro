---
import { siteConfig } from '../../config/SiteConfig'

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${siteConfig.seo.url}#services`,
  name: 'Garde d’animaux à domicile - Moumousse Pet Sitting',
  provider: {
    '@type': 'LocalBusiness',
    name: siteConfig.business.name,
    url: siteConfig.seo.url,
  },
  areaServed: {
    '@type': 'City',
    name: 'Pélussin et alentours',
  },
  serviceType: ['Pet Sitting', 'Dog Walking', 'Cat Sitting', 'Visites à domicile'],
  description:
    "Services de garde d'animaux à domicile, visites, soins et promenades pour chiens, chats et NAC à Pélussin et alentours.",
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Formules de garde et promenades',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'Visite ponctuelle à domicile',
        itemOffered: {
          '@type': 'Service',
          name: 'Visite à domicile',
          description:
            'Visite pour nourrir, nettoyer, jouer et câliner votre animal, avec envoi de nouvelles et photos.',
        },
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          priceCurrency: 'EUR',
          price: siteConfig.pricing.visit.zone1,
          unitText: 'Par visite (à partir de)',
        },
      },
      {
        '@type': 'Offer',
        name: 'Promenade canine',
        itemOffered: {
          '@type': 'Service',
          name: 'Promenade de chien',
          description: 'Promenade individuelle ou personnalisée pour votre chien.',
        },
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          priceCurrency: 'EUR',
          price: siteConfig.pricing.walking.zone1['1h'],
          unitText: 'Par heure (à partir de)',
        },
      },
    ],
  },
}
---

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
