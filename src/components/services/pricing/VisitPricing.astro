---
import { siteConfig } from '../../../config/SiteConfig'
import VisitPricingItem from './VisitPricingItem.astro'

export interface Props extends astroHTML.JSX.HTMLAttributes {}

const prices = [
  {
    label: `Zone 1 (${siteConfig.pricing.zones.zone1})`,
    price: `${siteConfig.pricing.visit.zone1}€`,
  },
  {
    label: `Zone 2 (${siteConfig.pricing.zones.zone2})`,
    price: `${siteConfig.pricing.visit.zone2}€`,
  },
  {
    label: `Zone 3 (${siteConfig.pricing.zones.zone3})`,
    price: `${siteConfig.pricing.visit.zone3}€`,
  },
]
---

<div {...Astro.props}>
  <div class="grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-4">
    {prices.map(({ label, price }) => <VisitPricingItem label={label} price={price} />)}

    <a href="/#contact" class="">
      <VisitPricingItem label="Au-delà de 20km" price="Me contacter" />
    </a>
  </div>
</div>
