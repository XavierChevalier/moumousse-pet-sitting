---
import { cn } from '../../../core/tailwindcn'

export interface Props extends astroHTML.JSX.HTMLAttributes {
  label: string
  price: string
}

const { label, price, class: className = '', ...props } = Astro.props
---

<div
  {...props}
  class={cn(
    'rounded-2xl border-2 border-black bg-white p-3 text-center transition hover:scale-[1.03] lg:p-4',
    className
  )}
>
  <div class="text-muted text-sm">{label}</div>
  <div class="text-xl font-black">{price}</div>
</div>
