---
import { AsteriskIcon } from '@lucide/astro'
import { siteConfig } from '../../../config/SiteConfig'

export interface Props extends astroHTML.JSX.HTMLAttributes {}

const prices = [
  {
    duration: '1h',
    zone1: `${siteConfig.pricing.walking.zone1['1h']}€`,
    zone2: `${siteConfig.pricing.walking.zone2['1h']}€`,
    zone3: `${siteConfig.pricing.walking.zone3['1h']}€`,
  },
  {
    duration: '1h30',
    zone1: `${siteConfig.pricing.walking.zone1['1h30']}€`,
    zone2: `${siteConfig.pricing.walking.zone2['1h30']}€`,
    zone3: `${siteConfig.pricing.walking.zone3['1h30']}€`,
  },
  {
    duration: '2h',
    zone1: `${siteConfig.pricing.walking.zone1['2h']}€`,
    zone2: `${siteConfig.pricing.walking.zone2['2h']}€`,
    zone3: `${siteConfig.pricing.walking.zone3['2h']}€`,
  },
]
---

<div {...Astro.props}>
  <div class="overflow-x-auto">
    <table class="w-full border-collapse border-4 border-black bg-white">
      <thead>
        <tr class="bg-secondary/10 text-black">
          <th class="border-2 border-black p-3 text-left font-bold">Durée</th>
          <th
            class="border-2 border-black p-3 text-center text-sm font-bold whitespace-nowrap sm:text-base"
            >Zone 1<br /><span class="text-xs font-normal sm:text-sm">0-10km</span></th
          >
          <th
            class="border-2 border-black p-3 text-center text-sm font-bold whitespace-nowrap sm:text-base"
            >Zone 2<br /><span class="text-xs font-normal sm:text-sm">10-15km</span></th
          >
          <th
            class="border-2 border-black p-3 text-center text-sm font-bold whitespace-nowrap sm:text-base"
            >Zone 3<br /><span class="text-xs font-normal sm:text-sm">15-20km</span></th
          >
        </tr>
      </thead>
      <tbody>
        {
          prices.map((price) => (
            <tr class="hover:bg-gray-50">
              <td class="border-2 border-black p-3 font-semibold">{price.duration}</td>
              <td class="border-2 border-black p-3 text-center text-lg font-black">
                {price.zone1}
              </td>
              <td class="border-2 border-black p-3 text-center text-lg font-black">
                {price.zone2}
              </td>
              <td class="border-2 border-black p-3 text-center text-lg font-black">
                {price.zone3}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="mt-3 text-sm text-gray-600">
    <AsteriskIcon class="mr-1 inline w-4" />
    Au-delà de 20km, <a href="/#contact" class="text-primary hover:underline">me contacter</a> pour un
    devis personnalisé.
  </p>
</div>
