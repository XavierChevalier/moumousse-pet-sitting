---
import { HeartIcon } from '@lucide/astro'
import { siteConfig } from '../../config/SiteConfig'
---

<aside
  aria-label="Annonce de fermeture définitive"
  class="relative overflow-hidden border-b-4 border-black bg-black px-4 py-6 text-white sm:py-8"
>
  <!-- Punk shapes -->
  <div class="pointer-events-none absolute inset-0 opacity-40" aria-hidden="true">
    <div class="border-tertiary absolute -top-6 left-6 h-16 w-16 rotate-12 border-4"></div>
    <div
      class="border-primary absolute right-10 -bottom-8 h-20 w-20 rotate-45 rounded-full border-4"
    >
    </div>
    <div
      class="border-b-secondary absolute top-5 right-24 hidden h-0 w-0 -rotate-12 border-r-12 border-b-20 border-l-12 border-r-transparent border-l-transparent sm:block"
    >
    </div>
  </div>

  <div
    class="relative mx-auto flex max-w-5xl flex-col items-center gap-4 text-center md:flex-row md:gap-8 md:text-left"
  >
    <p
      class="bg-secondary w-fit shrink-0 -rotate-2 px-[0.5em] py-[0.15em] text-lg font-black tracking-tight whitespace-nowrap text-black uppercase sm:text-2xl"
    >
      Fermeture définitive
    </p>

    <div class="space-y-1">
      <p class="text-base font-bold text-balance sm:text-lg">
        {siteConfig.business.name} a fermé ses portes{' '}
        <span class="text-primary">début octobre 2026</span>.
      </p>
      <p class="text-sm text-balance text-white/80 sm:text-base">
        Un immense merci à vous et à vos compagnons pour votre confiance et tous ces beaux moments
        partagés{' '}
        <HeartIcon
          class="text-accent fill-accent inline-block h-4 w-4 -translate-y-px align-middle"
          aria-hidden="true"
        />
      </p>
    </div>
  </div>

  <!-- Brand color strip -->
  <div class="absolute inset-x-0 bottom-0 flex h-1" aria-hidden="true">
    <span class="bg-primary flex-1"></span>
    <span class="bg-secondary flex-1"></span>
    <span class="bg-tertiary flex-1"></span>
    <span class="bg-accent flex-1"></span>
  </div>
</aside>
