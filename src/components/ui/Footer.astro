---
import { Image } from 'astro:assets'
import MoumousseMalisse from '../../assets/moumousse-malisse.webp'
import { siteConfig } from '../../config/SiteConfig'

export interface Props extends astroHTML.JSX.HTMLAttributes {}

const navLinks = [
  { href: '/#qui-suis-je', label: 'Qui suis-je ?' },
  { href: '/#services', label: 'Prestations & Tarifs' },
  { href: '/#galerie', label: 'Galerie' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/#contact', label: 'Contact' },
  { href: '/cgv', label: 'Conditions générales de vente' },
]
---

<footer {...Astro.props} class="bg-black px-4 py-12 text-white">
  <div class="container mx-auto max-w-7xl">
    <div class="flex flex-col flex-wrap items-center gap-8 md:flex-row">
      <!-- Logo Section -->
      <div class="flex min-w-[230px] justify-center lg:justify-start">
        <a href="/#" class="group flex items-center gap-3" data-umami-event="footer:click-logo">
          <Image
            src={MoumousseMalisse}
            alt={`${siteConfig.business.name} Logo`}
            width={80}
            height={120}
            loading="lazy"
            class="pointer-events-none h-[60px] w-auto select-none"
          />
          <div
            class="flex flex-col text-lg leading-5 font-black uppercase transition duration-150 group-hover:translate-x-1"
          >
            <span class="text-primary">Moumousse</span>
            <span class="text-white">Pet Sitting</span>
          </div>
        </a>
      </div>

      <!-- Navigation Links -->
      <nav class="grid grid-cols-1 md:grid-cols-2">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="hover:text-primary p-2 text-sm font-semibold tracking-wide text-white uppercase transition-colors duration-200"
              data-umami-event={`footer:click-${link.href.replace('#', '').replace('/', '') || 'home'}`}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Legal & Copyright Section -->
      <div class="mx-auto min-w-[220px] text-center md:text-right">
        <div class="flex flex-col gap-3">
          <div class="flex flex-col gap-1">
            <p class="text-sm font-bold">
              © 2025 <span class="text-secondary">{siteConfig.business.name}</span>
            </p>
            <p class="text-xs text-gray-400">
              Développé par <a
                href="https://www.linkedin.com/in/chevalier-xavier/"
                class="text-primary font-semibold"
                data-umami-event="footer:click-developer-linkedin"
                target="_blank"
                rel="noopener noreferrer">Xavier Chevalier</a
              >
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="mt-8 border-t border-gray-700 pt-6">
      <p class="text-center text-xs text-gray-500">
        Tous droits réservés. Service professionnel de garde d'animaux à domicile.
      </p>
    </div>
  </div>
</footer>
