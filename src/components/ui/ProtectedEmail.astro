---
import { siteConfig } from '../../config/SiteConfig'
import ProtectedContent from './ProtectedContent.astro'

export interface Props extends astroHTML.JSX.HTMLAttributes {}
---

<ProtectedContent
  {...Astro.props}
  encodedContent={siteConfig.contact.encodedEmail}
  placeholder="Cliquez pour voir l'email"
  contentType="email"
>
  <slot name="prepend" slot="prepend" />
</ProtectedContent>
