---
import { siteConfig } from '../../config/SiteConfig'

export interface Props extends astroHTML.JSX.HTMLAttributes {
  light?: boolean
  context: string
}

const { light = false, context, class: className = '', ...props } = Astro.props

const linkClass = light
  ? 'text-white hover:text-primary hover:bg-white/10'
  : 'text-black hover:text-primary hover:bg-black/5'

const socialLinks = [
  {
    href: siteConfig.social.instagram,
    label: 'Suivez-nous sur Instagram',
    event: `social:click-instagram-${context}`,
    path: 'M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z',
  },
  {
    href: siteConfig.social.facebook,
    label: 'Suivez-nous sur Facebook',
    event: `social:click-facebook-${context}`,
    path: 'M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.326-.043-1.557-.14-2.857-.14C11.928 2 10 3.657 10 6.7v2.8H7v4h3V22h4z',
  },
]
---

<div {...props} class={`flex items-center gap-2 ${className}`}>
  {
    socialLinks.map(({ href, label, event, path }) => (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class={`focus:ring-primary rounded-full p-2 transition-colors duration-200 focus:ring-2 focus:ring-offset-2 focus:outline-none ${
          light ? 'focus:ring-offset-black' : 'focus:ring-offset-white'
        } ${linkClass}`}
        aria-label={label}
        data-umami-event={event}
      >
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d={path} />
        </svg>
      </a>
    ))
  }
</div>
