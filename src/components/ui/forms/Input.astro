---
import { cva, type VariantProps } from 'class-variance-authority'
import { cn } from '../../../core/tailwindcn'

const inputVariants = cva(
  'w-full border-4 border-black bg-white font-bold tracking-wide transition-all duration-200 focus:border-primary focus:outline-none',
  {
    variants: {
      size: {
        small: 'px-3 py-2 text-sm',
        medium: 'px-4 py-3 text-base',
        large: 'px-4 py-3 text-lg',
      },
    },
    defaultVariants: {
      size: 'large',
    },
  }
)

export interface Props
  extends VariantProps<typeof inputVariants>,
    Omit<astroHTML.JSX.InputHTMLAttributes, 'size'> {}

const { size, class: className = '', type = 'text', ...props } = Astro.props
---

<input class={cn(inputVariants({ size }), className)} type={type} {...props} />
