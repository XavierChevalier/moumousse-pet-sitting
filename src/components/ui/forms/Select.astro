---
import { ChevronDown } from '@lucide/astro'
import { cva, type VariantProps } from 'class-variance-authority'
import { cn } from '../../../core/tailwindcn'

const selectVariants = cva(
  'w-full border-4 border-black bg-white font-bold tracking-wide transition-all duration-200 focus:border-primary focus:outline-none appearance-none',
  {
    variants: {
      size: {
        small: 'pl-3 pr-8 py-2 text-sm',
        medium: 'pl-4 pr-9 py-3 text-base',
        large: 'pl-4 pr-10 py-3 text-lg',
      },
    },
    defaultVariants: {
      size: 'large',
    },
  }
)

export interface Props
  extends VariantProps<typeof selectVariants>,
    Omit<astroHTML.JSX.SelectHTMLAttributes, 'size'> {}

const { size, class: className = '', ...props } = Astro.props
---

<div class="relative w-full">
  <select class={cn(selectVariants({ size }), className)} {...props}>
    <slot />
  </select>

  <span
    class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-black"
    aria-hidden="true"
  >
    <ChevronDown class="h-4 w-4" />
  </span>
</div>
