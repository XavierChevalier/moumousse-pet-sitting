---
import { cva, type VariantProps } from 'class-variance-authority'
import { cn } from '../../../core/tailwindcn'

const selectVariants = cva(
  'w-full border-4 border-black bg-white font-bold tracking-wide transition-all duration-200 focus:border-primary focus:outline-none',
  {
    variants: {
      size: {
        small: 'px-3 py-2 text-sm',
        medium: 'px-4 py-3 text-base',
        large: 'px-4 py-3 text-lg',
      },
    },
    defaultVariants: {
      size: 'large',
    },
  }
)

export interface Props
  extends VariantProps<typeof selectVariants>,
    Omit<astroHTML.JSX.SelectHTMLAttributes, 'size'> {}

const { size, class: className = '', ...props } = Astro.props
---

<select class={cn(selectVariants({ size }), className)} {...props}>
  <slot />
</select>
