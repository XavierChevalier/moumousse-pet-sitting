---
import { Globe, Mail, Phone } from '@lucide/astro'
---

<article
  class="bg-body relative z-0 flex h-[55mm] w-[85mm] flex-col justify-between overflow-hidden border-[3px] border-black p-4 text-xs"
>
  <div class="absolute inset-0 opacity-10">
    <div class="border-primary absolute top-10 -right-4 h-12 w-12 rotate-45 border-4"></div>

    <!-- Triangles -->
    <div
      class="border-b-tertiary absolute top-32 right-1/3 h-0 w-0 rotate-12 border-r-[10px] border-b-[18px] border-l-[10px] border-r-transparent border-l-transparent"
    >
    </div>

    <!-- More geometric shapes -->
    <div
      class="border-secondary absolute -right-5 -bottom-5 size-20 rotate-45 rounded-full border-4"
    >
    </div>
  </div>

  <header class="mb-3">
    <div class="flex flex-col text-lg leading-5">
      <span class="text-primary font-black uppercase">Steffie Thollot</span>
      <span class="text-[14px] text-black/90">Pet sitter professionnelle</span>
    </div>
  </header>

  <dl class="space-y-1.5 text-[9px] leading-snug text-black">
    <div class="flex items-center gap-2">
      <Phone class="h-3 w-3 text-black" aria-hidden="true" />
      <span>06 46 47 30 11</span>
    </div>
    <div class="flex items-center gap-2">
      <Mail class="h-3 w-3 text-black" aria-hidden="true" />
      <span>contact@moumousse-pet-sitting.fr</span>
    </div>
    <div class="flex items-center gap-2">
      <Globe class="h-3 w-3 text-black" aria-hidden="true" />
      <span>moumousse-pet-sitting.fr</span>
    </div>
    <!-- <div class="flex items-center gap-2">
      <MapPin class="h-3 w-3 text-black" aria-hidden="true" />
      <span>Pélussin (42)</span>
    </div> -->
  </dl>

  <p class="mt-3 text-[10px] leading-tight font-medium tracking-wide text-black/80 uppercase">
    Visites à domicile &amp; promenades<br />– Pélussin et alentours
  </p>
</article>
