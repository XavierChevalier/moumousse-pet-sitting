---
import { Link, Mail, Phone } from '@lucide/astro'
---

<article
  class="bg-body relative z-0 flex h-[55mm] w-[85mm] flex-col justify-between overflow-hidden p-4 px-5"
>
  <div class="absolute inset-0 opacity-15">
    <div class="border-primary absolute top-10 -right-4 h-12 w-12 rotate-45 border-4"></div>

    <!-- Triangles -->
    <div
      class="border-b-tertiary absolute top-[42px] right-[80px] h-0 w-0 rotate-12 border-r-[10px] border-b-[18px] border-l-[10px] border-r-transparent border-l-transparent"
    >
    </div>

    <!-- More geometric shapes -->
    <div
      class="border-secondary absolute -right-5 -bottom-5 size-20 rotate-45 rounded-full border-4"
    >
    </div>
  </div>

  <header>
    <div class="-space-y-1">
      <h2 class="text-primary text-lg font-black tracking-wide uppercase">Steffie Thollot</h2>
      <span class="text-sm leading-snug tracking-[0.014em] text-black/90"
        >Pet Sitter Professionnelle</span
      >
    </div>
  </header>

  <dl class="space-y-1.5 text-sm leading-relaxed text-black">
    <div class="flex items-center gap-2">
      <Phone class="size-4 flex-shrink-0 text-black" aria-hidden="true" />
      <span class="font-semibold">06 46 47 30 11</span>
    </div>

    <div class="flex items-center gap-2">
      <Link class="size-4 flex-shrink-0 text-black" aria-hidden="true" />
      <span class="font-semibold">moumousse-pet-sitting.fr</span>
    </div>

    <div class="flex items-center gap-2">
      <Mail class="size-4 flex-shrink-0 text-black" aria-hidden="true" />
      <span class="font-semibold">contact@moumousse-pet-sitting.fr</span>
    </div>
  </dl>

  <div class="space-y-1 text-xs tracking-wide text-black/80 uppercase">
    <p class="">Visites à domicile &amp; promenades</p>
  </div>
</article>
