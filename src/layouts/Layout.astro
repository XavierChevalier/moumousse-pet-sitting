---
import Navigation from '../components/navigations/Navigation.astro'
import Footer from '../components/ui/Footer.astro'
import SEO from '../components/SEO.astro'
import { siteConfig, type SEOConfig } from '../config/SiteConfig'
import '../styles/global.css'

interface Props extends Partial<SEOConfig> {}

const seoProps = Astro.props
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicons -->
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="copyright"
      content={`© 2025 ${siteConfig.business.name} & Jeeves Studio. Tous droits réservés.`}
    />

    <!-- SEO Meta Tags -->
    <SEO {...seoProps} />

    <!-- Google Fonts - optimized loading with font-display: swap and async loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=Fredoka:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=Fredoka:wght@400;500;600;700&display=swap"
      />
    </noscript>

    <!-- Preload critical hero image -->
    <link
      rel="preload"
      as="image"
      href="/moumousse-malisse.webp"
      fetchpriority="high"
    />

    <!-- Umami Analytics - async loading -->
    <script
      defer
      src="https://umami-production-6320.up.railway.app/script.js"
      data-website-id="4d35333e-130b-4d7d-b00b-2ca3d21e88b1"
    ></script>

    <!-- Service Worker Registration -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register('/sw.js')
            .then((registration) => {
              console.log('Service Worker registered:', registration.scope)
            })
            .catch((error) => {
              console.warn('Service Worker registration failed:', error)
            })
        })
      }
    </script>
  </head>

  <body class="bg-body overflow-x-hidden font-sans text-base text-black">
    <Navigation />

    <main class="min-h-screen overflow-hidden pt-20">
      <slot />
    </main>

    <Footer />
  </body>
</html>
