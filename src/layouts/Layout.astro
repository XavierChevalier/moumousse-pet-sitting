---
import Navigation from '../components/navigations/Navigation.astro'
import Footer from '../components/ui/Footer.astro'
import { siteConfig } from '../config/SiteConfig'
import '../styles/global.css'
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="copyright"
      content={`© 2025 ${siteConfig.business.name} & Jeeves Studio. Tous droits réservés.`}
    />
    <meta
      name="description"
      content={`${siteConfig.business.name} - Garde d'animaux de compagnie à domicile par ${siteConfig.business.ownerName}. Service professionnel et passionné.`}
    />
    <meta
      name="keywords"
      content="pet sitting, garde animaux, domicile, Pélussin, chien, chat, NAC, professionnel"
    />

    <title>{siteConfig.business.name} - Garde d'animaux de compagnie à domicile</title>

    <!-- Google Fonts - Punk/Bold Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=Fredoka:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Umami Analytics -->
    <script
      defer
      src="https://umami-production-6320.up.railway.app/script.js"
      data-website-id="4d35333e-130b-4d7d-b00b-2ca3d21e88b1"></script>
  </head>

  <body class="bg-body overflow-x-hidden font-sans text-base text-black">
    <Navigation />

    <main class="min-h-screen overflow-hidden pt-20">
      <slot />
    </main>

    <Footer />
  </body>
</html>
