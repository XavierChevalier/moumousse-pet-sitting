---
import Layout from '../layouts/Layout.astro'
import Navigation from '../components/navigations/Navigation.astro'
import Footer from '../components/ui/Footer.astro'
import MoumousseMalisse from '../assets/moumousse-malisse.webp'
import { Picture } from 'astro:assets'
import PunkBackground from '../components/ui/PunkBackground.astro'
import Button from '../components/ui/Button.astro'
---

<Layout>
  <Navigation />

  <main class="min-h-screen overflow-hidden pt-20">
    <section
      class="relative flex min-h-[80vh] flex-col justify-center gap-12 px-4 py-20 sm:gap-16 lg:gap-24"
    >
      <PunkBackground />

      <div class="relative z-10 container mx-auto max-w-7xl">
        <div class="grid items-center gap-12 sm:gap-16 lg:grid-cols-2 lg:gap-24">
          <div class="space-y-6 text-center lg:text-left">
            <div class="mb-8">
              <h1
                class="text-3xl leading-tight font-black tracking-wide text-balance uppercase sm:text-4xl md:text-5xl lg:text-6xl"
              >
                <span class="text-outline text-primary transform whitespace-nowrap" data-text="404">
                  404
                </span>
                <span
                  class="text-outline text-secondary transform whitespace-nowrap"
                  data-text="Page introuvable"
                >
                  Page introuvable
                </span>
              </h1>
            </div>

            <p class="text-lg font-bold text-black sm:text-xl">
              Cette page semble avoir disparu...
            </p>

            <p class="mx-auto max-w-md text-base text-gray-600 lg:mx-0">
              Pas de panique ! Retournons à l'accueil pour retrouver nos petits protégés.
            </p>

            <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row lg:justify-start">
              <Button href="/" variant="filled">Retour à l'accueil</Button>
            </div>
          </div>

          <Picture
            src={MoumousseMalisse}
            formats={['avif', 'webp']}
            alt="Chat perdu - Erreur 404"
            class="pointer-events-none mx-auto w-40 select-none sm:w-48 md:w-80 lg:w-auto"
          />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
