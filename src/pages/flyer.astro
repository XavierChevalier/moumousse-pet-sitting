---
import FlyerFace1_4 from '../components/printables/flyer/FlyerFace1-4.astro'
import FlyerFace2_3 from '../components/printables/flyer/FlyerFace2-3.astro'
import PrintableDimensionsPanel from '../components/printables/PrintableDimensionsPanel.astro'
import PrintableExportCard from '../components/printables/PrintableExportCard.astro'
import PrintablesSidebar from '../components/printables/PrintablesSidebar.astro'
import PrintablesToolbar from '../components/printables/PrintablesToolbar.astro'
import Ruler from '../components/printables/Ruler.astro'
import SEO from '../components/SEO.astro'
import { siteConfig } from '../config/SiteConfig'
import { createPrintableDimensions } from '../core/printables/dimensions'
import '../styles/global.css'
import '../components/printables/printables.css'

if (!import.meta.env.DEV) {
  return new Response(null, { status: 404 })
}

const dimensions = createPrintableDimensions({
  dpiMultiplier: 3,
  baseDpi: 300,
  finishedWidthMm: 210,
  finishedHeightMm: 210,
  bleedMm: 2,
  safeZoneMm: 3,
  contentPaddingMm: 8,
  pageWidthMm: 242,
  pageHeightMm: 242,
  cropMarkOffsetFromPageEdgeMm: 16, // pageMargin (14) + bleed (2) = standard crop mark offset
})

const faces = [
  { id: 'flyer-face-1-4', label: 'Face 1-4' },
  { id: 'flyer-face-2-3', label: 'Face 2-3' },
] satisfies Array<{ id: string; label: string }>
const currentFaceId = 'flyer-face-1-4'
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title="Flyer 4 faces - Moumousse Pet Sitting"
      description="Prévisualisez et exportez en PDF le flyer 4 faces Moumousse Pet Sitting pour impression (format plié 105mm×210mm, ouvert 210mm×210mm)."
      image={siteConfig.seo.image}
      imageAlt={siteConfig.seo.imageAlt}
      noindex={true}
    />
  </head>

  <body class="m-0 bg-[#faf8f6] p-0 font-sans text-base text-black">
    <PrintablesToolbar
      dimensions={dimensions}
      currentPage="flyer"
      currentFaceId={currentFaceId}
      faces={faces}
    />

    <PrintablesSidebar faces={faces} currentFaceId={currentFaceId} />

    <Ruler dimensions={dimensions} />

    <main
      class="fixed inset-0 overflow-auto pt-16 pl-48"
      id="printables-main"
      style="top: var(--toolbar-height, 56px); left: 192px; cursor: default;"
    >
      <div
        class="relative flex min-h-full flex-col items-center justify-center gap-8 p-8"
        id="printables-content"
        style="min-width: 200%; min-height: 200%;"
      >
        <PrintableExportCard
          targetId="flyer-face-1-4"
          dimensions={dimensions}
          overlaySrc="/printables/210x210-crop-marks-recto.png"
          visible={String(currentFaceId) === 'flyer-face-1-4'}
        >
          <FlyerFace1_4 withBleed={true} />
        </PrintableExportCard>

        <PrintableExportCard
          targetId="flyer-face-2-3"
          dimensions={dimensions}
          overlaySrc="/printables/210x210-crop-marks-verso.png"
          visible={String(currentFaceId) === 'flyer-face-2-3'}
        >
          <FlyerFace2_3 withBleed={true} />
        </PrintableExportCard>
      </div>
    </main>

    <PrintableDimensionsPanel dimensions={dimensions} title="Dimensions (flyer)" />

    <script>
      import { setupContentCentering } from '../components/printables/behaviors/centering'
      import { createPanningController } from '../components/printables/behaviors/panning'

      const main = document.getElementById('printables-main')
      if (main) {
        setupContentCentering(main)
        createPanningController(main)
      }
    </script>
  </body>
</html>
