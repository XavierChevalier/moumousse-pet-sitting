---
import { ArrowLeftIcon } from '@lucide/astro'
import FlyerFace1_4 from '../components/printables/flyer/FlyerFace1-4.astro'
import FlyerFace2_3 from '../components/printables/flyer/FlyerFace2-3.astro'
import PrintableDimensionsPanel from '../components/printables/PrintableDimensionsPanel.astro'
import PrintableExportCard from '../components/printables/PrintableExportCard.astro'
import SEO from '../components/SEO.astro'
import { siteConfig } from '../config/SiteConfig'
import { createPrintableDimensions } from '../core/printables/dimensions'
import '../styles/global.css'

if (!import.meta.env.DEV) {
  return new Response(null, { status: 404 })
}

const dimensions = createPrintableDimensions({
  dpiMultiplier: 3,
  baseDpi: 300,
  finishedWidthMm: 210,
  finishedHeightMm: 210,
  bleedMm: 2,
  safeZoneMm: 4,
  contentPaddingMm: 4,
  pageWidthMm: 234,
  pageHeightMm: 234,
})
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title="Flyer 4 faces - Moumousse Pet Sitting"
      description="Prévisualisez et exportez en PDF le flyer 4 faces Moumousse Pet Sitting pour impression (format plié 105mm×210mm, ouvert 210mm×210mm)."
      image={siteConfig.seo.image}
      imageAlt={siteConfig.seo.imageAlt}
      noindex={true}
    />
  </head>

  <body class="m-0 bg-[#faf8f6] p-0 font-sans text-base text-black">
    <a
      href="/visit-card/"
      class="fixed top-4 right-4 z-[100] inline-flex items-center gap-2 rounded-md bg-[#3ecfb1] px-4 py-2 text-sm font-semibold text-white no-underline transition-colors hover:bg-[#35b89c] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3ecfb1cc]"
    >
      <ArrowLeftIcon class="size-4" aria-hidden="true" />
      Aller à la carte de visite
    </a>
    <main class="flex min-h-screen flex-col items-center gap-8 p-8">
      <PrintableDimensionsPanel dimensions={dimensions} title="Dimensions (flyer)" />

      <PrintableExportCard
        label="Face 1-4"
        targetId="flyer-face-1-4"
        filename="flyer-face-1-4"
        dimensions={dimensions}
      >
        <FlyerFace1_4 withBleed={true} />
      </PrintableExportCard>

      <PrintableExportCard
        label="Face 2-3"
        targetId="flyer-face-2-3"
        filename="flyer-face-2-3"
        dimensions={dimensions}
      >
        <FlyerFace2_3 withBleed={true} />
      </PrintableExportCard>
    </main>
  </body>
</html>
