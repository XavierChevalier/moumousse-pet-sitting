---
import Layout from '../layouts/Layout.astro'
import Navigation from '../components/navigations/Navigation.astro'
import HeroSection from '../components/home/HeroSection.astro'
import ServicesSection from '../components/services/ServicesSection.astro'
import MeSection from '../components/about-me/MeSection.astro'
import GallerySection from '../components/galleries/GallerySection.astro'
import FAQSection from '../components/faqs/FAQSection.astro'
import ContactSection from '../components/contacts/ContactSection.astro'
---

<Layout>
  <Navigation />

  <main class="min-h-screen overflow-hidden pt-20">
    <HeroSection />

    <MeSection />

    <ServicesSection id="services" />

    <GallerySection id="galerie" />

    <FAQSection id="faq" />

    <ContactSection id="contact" />
  </main>
</Layout>
