---
import SEO from '../components/SEO.astro'
import PrintableDimensionsPanel from '../components/printables/PrintableDimensionsPanel.astro'
import PrintableExportCard from '../components/printables/PrintableExportCard.astro'
import PrintablesSidebar from '../components/printables/PrintablesSidebar.astro'
import PrintablesToolbar from '../components/printables/PrintablesToolbar.astro'
import Ruler from '../components/printables/Ruler.astro'
import VisitCardRecto from '../components/printables/visit-card/VisitCardRecto.astro'
import VisitCardVerso from '../components/printables/visit-card/VisitCardVerso.astro'
import { siteConfig } from '../config/SiteConfig'
import { createPrintableDimensions } from '../core/printables/dimensions'
import '../styles/global.css'

if (!import.meta.env.DEV) {
  return new Response(null, { status: 404 })
}

const dimensions = createPrintableDimensions({
  dpiMultiplier: 2,
  baseDpi: 300,
  finishedWidthMm: 85,
  finishedHeightMm: 54,
  bleedMm: 2,
  safeZoneMm: 3,
  contentPaddingMm: 4,
  baseTargetWidthPx: 1347,
  baseTargetHeightPx: 981,
})

const faces = [
  { id: 'card-recto', label: 'Recto' },
  { id: 'card-verso', label: 'Verso' },
]
const currentFaceId = 'card-recto'
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title="Carte de visite - Moumousse Pet Sitting"
      description="Prévisualisez et exportez en PDF la carte de visite Moumousse Pet Sitting pour impression."
      image={siteConfig.seo.image}
      imageAlt={siteConfig.seo.imageAlt}
      noindex={true}
    />
  </head>

  <body class="m-0 bg-[#faf8f6] p-0 font-sans text-base text-black">
    <PrintablesToolbar
      dimensions={dimensions}
      currentPage="visit-card"
      currentFaceId={currentFaceId}
      faces={faces}
    />

    <PrintablesSidebar faces={faces} currentFaceId={currentFaceId} />

    <Ruler dimensions={dimensions} />

    <main
      class="fixed inset-0 overflow-auto pt-16 pl-48"
      id="printables-main"
      style="top: var(--toolbar-height, 56px); left: 192px; cursor: default;"
    >
      <div
        class="relative flex min-h-full flex-col items-center justify-center gap-8 p-8"
        id="printables-content"
        style="min-width: 200%; min-height: 200%;"
      >
        <!-- Recto -->
        <PrintableExportCard
          label="Recto"
          targetId="card-recto"
          filename="carte-visite-recto"
          dimensions={dimensions}
          overlaySrc="/printables/85x54_H_coins-droits.png"
          visible={currentFaceId === 'card-recto'}
        >
          <VisitCardRecto withBleed={true} />
        </PrintableExportCard>

        <!-- Verso -->
        <PrintableExportCard
          label="Verso"
          targetId="card-verso"
          filename="carte-visite-verso"
          dimensions={dimensions}
          overlaySrc="/printables/85x54_H_coins-droits.png"
          visible={currentFaceId === 'card-verso'}
        >
          <VisitCardVerso withBleed={true} />
        </PrintableExportCard>
      </div>
    </main>

    <PrintableDimensionsPanel dimensions={dimensions} />

    <script is:inline>
      ;(function () {
        'use strict'

        const main = document.getElementById('printables-main')
        const content = document.getElementById('printables-content')
        if (!main || !content) return

        // Center content initially - find the visible card and center it
        function centerContent() {
          // Find the visible card
          const containers = document.querySelectorAll('[data-face-container]')
          let visibleCard = null
          for (const container of containers) {
            if (!container.classList.contains('hidden')) {
              const cardId = container.getAttribute('data-face-container')
              if (cardId) {
                visibleCard = document.getElementById(cardId)
                break
              }
            }
          }

          if (!visibleCard) return

          const mainRect = main.getBoundingClientRect()
          const cardRect = visibleCard.getBoundingClientRect()

          // Calculate scroll position to center the card
          const cardCenterX = cardRect.left + cardRect.width / 2
          const cardCenterY = cardRect.top + cardRect.height / 2
          const mainCenterX = mainRect.left + mainRect.width / 2
          const mainCenterY = mainRect.top + mainRect.height / 2

          const scrollX = main.scrollLeft + (cardCenterX - mainCenterX)
          const scrollY = main.scrollTop + (cardCenterY - mainCenterY)

          main.scrollLeft = scrollX
          main.scrollTop = scrollY
        }

        // Center on load - wait for everything to be ready
        function initCentering() {
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => {
              setTimeout(() => {
                centerContent()
                // Also center after a short delay to ensure all content is loaded
                setTimeout(centerContent, 300)
              }, 100)
            })
          } else {
            setTimeout(() => {
              centerContent()
              setTimeout(centerContent, 300)
            }, 100)
          }
        }

        initCentering()

        let isPanning = false
        let isSpacePressed = false
        let startX = 0
        let startY = 0
        let scrollLeft = 0
        let scrollTop = 0

        // Space key handlers
        document.addEventListener('keydown', (e) => {
          if (e.code === 'Space' && !e.target.matches('input, textarea')) {
            e.preventDefault()
            isSpacePressed = true
            main.style.cursor = 'grab'
          }
        })

        document.addEventListener('keyup', (e) => {
          if (e.code === 'Space') {
            isSpacePressed = false
            if (!isPanning) {
              main.style.cursor = ''
            }
          }
        })

        // Mouse down - start panning
        main.addEventListener('mousedown', (e) => {
          // Space + click or middle mouse button
          if (isSpacePressed || e.button === 1) {
            e.preventDefault()
            isPanning = true
            main.style.cursor = 'grabbing'
            const rect = main.getBoundingClientRect()
            startX = e.clientX - rect.left
            startY = e.clientY - rect.top
            scrollLeft = main.scrollLeft
            scrollTop = main.scrollTop
          }
        })

        // Mouse move - pan
        main.addEventListener('mousemove', (e) => {
          if (!isPanning) return
          e.preventDefault()
          const rect = main.getBoundingClientRect()
          const x = e.clientX - rect.left
          const y = e.clientY - rect.top
          const walkX = x - startX
          const walkY = y - startY
          main.scrollLeft = scrollLeft - walkX
          main.scrollTop = scrollTop - walkY
        })

        // Mouse up - stop panning
        main.addEventListener('mouseup', (e) => {
          if (isPanning) {
            isPanning = false
            if (isSpacePressed) {
              main.style.cursor = 'grab'
            } else {
              main.style.cursor = ''
            }
          }
        })

        // Mouse leave - stop panning
        main.addEventListener('mouseleave', () => {
          if (isPanning) {
            isPanning = false
            if (isSpacePressed) {
              main.style.cursor = 'grab'
            } else {
              main.style.cursor = ''
            }
          }
        })

        // Prevent context menu on middle click
        main.addEventListener('contextmenu', (e) => {
          if (e.button === 1) {
            e.preventDefault()
          }
        })
      })()
    </script>
  </body>
</html>
