---
import SEO from '../components/SEO.astro'
import PrintableDimensionsPanel from '../components/printables/PrintableDimensionsPanel.astro'
import PrintableExportCard from '../components/printables/PrintableExportCard.astro'
import PrintablesSidebar from '../components/printables/PrintablesSidebar.astro'
import PrintablesToolbar from '../components/printables/PrintablesToolbar.astro'
import Ruler from '../components/printables/Ruler.astro'
import VisitCardRecto from '../components/printables/visit-card/VisitCardRecto.astro'
import VisitCardVerso from '../components/printables/visit-card/VisitCardVerso.astro'
import { siteConfig } from '../config/SiteConfig'
import { createPrintableDimensions } from '../core/printables/dimensions'
import '../styles/global.css'
import '../components/printables/printables.css'

if (!import.meta.env.DEV) {
  return new Response(null, { status: 404 })
}

const dimensions = createPrintableDimensions({
  dpiMultiplier: 2,
  baseDpi: 300,
  finishedWidthMm: 85,
  finishedHeightMm: 54,
  bleedMm: 2,
  safeZoneMm: 3,
  contentPaddingMm: 4,
  baseTargetWidthPx: 1347,
  baseTargetHeightPx: 981,
})

const faces = [
  { id: 'card-recto', label: 'Recto' },
  { id: 'card-verso', label: 'Verso' },
] satisfies Array<{ id: string; label: string }>
const currentFaceId = 'card-recto'
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title="Carte de visite - Moumousse Pet Sitting"
      description="Prévisualisez et exportez en PDF la carte de visite Moumousse Pet Sitting pour impression."
      image={siteConfig.seo.image}
      imageAlt={siteConfig.seo.imageAlt}
      noindex={true}
    />
  </head>

  <body class="m-0 bg-[#faf8f6] p-0 font-sans text-base text-black">
    <PrintablesToolbar
      dimensions={dimensions}
      currentPage="visit-card"
      currentFaceId={currentFaceId}
      faces={faces}
    />

    <PrintablesSidebar faces={faces} currentFaceId={currentFaceId} />

    <Ruler dimensions={dimensions} />

    <main
      class="fixed inset-0 overflow-auto pt-16 pl-48"
      id="printables-main"
      style="top: var(--toolbar-height, 56px); left: 192px; cursor: default;"
    >
      <div
        class="relative flex min-h-full flex-col items-center justify-center gap-8 p-8"
        id="printables-content"
        style="min-width: 200%; min-height: 200%;"
      >
        <!-- Front -->
        <PrintableExportCard
          targetId="card-recto"
          dimensions={dimensions}
          overlaySrc="/printables/85x54_H_coins-droits.png"
          visible={String(currentFaceId) === 'card-recto'}
        >
          <VisitCardRecto withBleed={true} />
        </PrintableExportCard>

        <!-- Back -->
        <PrintableExportCard
          targetId="card-verso"
          dimensions={dimensions}
          overlaySrc="/printables/85x54_H_coins-droits.png"
          visible={String(currentFaceId) === 'card-verso'}
        >
          <VisitCardVerso withBleed={true} />
        </PrintableExportCard>
      </div>
    </main>

    <PrintableDimensionsPanel dimensions={dimensions} />

    <script>
      import { setupContentCentering } from '../components/printables/behaviors/centering'
      import { createPanningController } from '../components/printables/behaviors/panning'

      const main = document.getElementById('printables-main')
      if (main) {
        setupContentCentering(main)
        createPanningController(main)
      }
    </script>
  </body>
</html>
