---
import { ArrowRightIcon } from '@lucide/astro'
import SEO from '../components/SEO.astro'
import PrintableDimensionsPanel from '../components/printables/PrintableDimensionsPanel.astro'
import PrintableExportCard from '../components/printables/PrintableExportCard.astro'
import VisitCardRecto from '../components/printables/visit-card/VisitCardRecto.astro'
import VisitCardVerso from '../components/printables/visit-card/VisitCardVerso.astro'
import { siteConfig } from '../config/SiteConfig'
import { createPrintableDimensions } from '../core/printables/dimensions'
import '../styles/global.css'

if (!import.meta.env.DEV) {
  return new Response(null, { status: 404 })
}

const dimensions = createPrintableDimensions({
  dpiMultiplier: 2,
  baseDpi: 300,
  finishedWidthMm: 85,
  finishedHeightMm: 54,
  bleedMm: 2,
  safeZoneMm: 3,
  contentPaddingMm: 4,
  baseTargetWidthPx: 1347,
  baseTargetHeightPx: 981,
})
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title="Carte de visite - Moumousse Pet Sitting"
      description="Prévisualisez et exportez en PDF la carte de visite Moumousse Pet Sitting pour impression."
      image={siteConfig.seo.image}
      imageAlt={siteConfig.seo.imageAlt}
      noindex={true}
    />
  </head>

  <body class="m-0 bg-[#faf8f6] p-0 font-sans text-base text-black">
    <a
      href="/flyer/"
      class="fixed top-4 right-4 z-[100] inline-flex items-center gap-2 rounded-md bg-[#3ecfb1] px-4 py-2 text-sm font-semibold text-white no-underline transition-colors hover:bg-[#35b89c] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3ecfb1cc]"
    >
      <ArrowRightIcon class="size-4" aria-hidden="true" />
      Aller au flyer
    </a>
    <main class="flex min-h-screen flex-col items-center gap-8 p-8">
      <PrintableDimensionsPanel
        dimensions={dimensions}
      />

      <!-- Recto -->
      <PrintableExportCard
        label="Recto"
        targetId="card-recto"
        filename="carte-visite-recto"
        dimensions={dimensions}
        overlaySrc="/85x54_H_coins-droits.png"
      >
        <VisitCardRecto withBleed={true} />
      </PrintableExportCard>

      <!-- Verso -->
      <PrintableExportCard
        label="Verso"
        targetId="card-verso"
        filename="carte-visite-verso"
        dimensions={dimensions}
        overlaySrc="/85x54_H_coins-droits.png"
      >
        <VisitCardVerso withBleed={true} />
      </PrintableExportCard>
    </main>
  </body>
</html>
